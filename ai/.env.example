# services/ai — env khi chay ngoai Docker (`uv run fastapi dev`).
# Trong Docker thi cac bien nay do docker-compose truyen vao tu .env o ROOT repo.

INTERNAL_TOKEN=dev-internal-token-doi-truoc-khi-deploy

# mock = khong goi provider that, tra du lieu gia dung cau truc envelope.
AI_PROVIDER=mock
GEMINI_API_KEY=

# De trong thi dung LocalStorage (ghi vao /tmp trong container).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=story-assets
