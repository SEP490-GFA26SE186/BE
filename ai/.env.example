# ai/ — env khi chay ngoai Docker (`.venv/Scripts/python -m uvicorn app.main:app --reload`).
# Trong Docker thi cac bien nay do docker-compose truyen vao tu .env o ROOT repo.
# Danh sach theo spec 4.4. KHONG co DATABASE_URL / REDIS_URL: service nay stateless.

# Dung chung voi Node. Bat buoc, khong co mac dinh.
INTERNAL_TOKEN=dev-internal-token-doi-truoc-khi-deploy

# ---- Provider ---------------------------------------------------------------
# mock = khong goi ben ngoai, tra du lieu hop le theo khung request (di qua validator that).
LLM_PROVIDER=mock                  # mock | gemini | claude | claude_code
TTS_PROVIDER=mock                  # mock (vieneu: M5)

# Chi can khi LLM_PROVIDER=gemini. GEMINI_TEXT_MODEL phai ton tai (kiem luc khoi dong).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=

# ---- Claude (README "Claude") ------------------------------------------------
# claude      = Anthropic API. ANTHROPIC_API_KEY tuy chon: de trong thi SDK tu tim (bien moi
#               truong, roi profile `ant auth login`). Tinh tien theo token vao workspace do.
# claude_code = CLI `claude` (goi Pro/Max), qua claude-agent-sdk. Can `pip install -e ".[claude-code]"`
#               (Docker: AI_EXTRAS=claude-code). Dang nhap: `claude login` tren may, hoac
#               CLAUDE_CODE_OAUTH_TOKEN (tu `claude setup-token`) — cach duy nhat trong container.
# Ca hai: KHONG dat LLM_TEMPERATURE / LLM_RETRY_TEMPERATURE (Settings tu choi).
ANTHROPIC_API_KEY=
# Chi claude_code. Trong = CLI dung phien `claude login` tren may.
CLAUDE_CODE_OAUTH_TOKEN=
# Tu 2026-10-19 (docs/01): claude_code la provider chinh, ca dev lan ban deploy cua do an.
# Cau hinh da do: model sonnet (API: claude-sonnet-5-5), LLM_CLAUDE_EFFORT=low, thinking de trong,
# LLM_THINKING_BUDGET=12000. claude: model id. claude_code: model id hoac alias CLI (vd. sonnet).
LLM_CLAUDE_MODEL=
# Trong = khong gui (mac dinh cua model). disabled | adaptive | between_tools (between_tools: chi API).
# Bat thinking thi dat LLM_THINKING_BUDGET > 0 lam phan du tru cong vao tran token.
LLM_CLAUDE_THINKING=
# Trong = khong gui. low | medium | high | xhigh | max
LLM_CLAUDE_EFFORT=
# claude_code: trong = SDK tu tim `claude` (PATH). Windows + npm: PHAI dat, vi PATH chi co claude.CMD:
#   C:\Users\<ban>\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
LLM_CLAUDE_CLI_PATH=

# ---- Gemini (chi chu; anh khong dung Gemini) --------------------------------
# Bat bien thoi gian: AI_TIMEOUT_MS_STORY_TEXT (Node) > 2 x LLM_TIMEOUT_SECONDS + overhead. Xem README.
LLM_TIMEOUT_SECONDS=150
# Trong = mac dinh cua SDK / model. (Comment dat tren dong rieng: dotenv doc `VAR=   # x` la gia tri "# x".)
LLM_TEMPERATURE=
# Trong = KHONG gui nhiet do cho lan thu lai (mac dinh; docs/01 giai thich).
LLM_RETRY_TEMPERATURE=
LLM_THINKING_BUDGET=0              # 0 = tat thinking; > 0 = budget co dinh CONG THEM vao tran token
LLM_TRUNCATION_RETRY_FACTOR=1.5    # lan thu lai sau OUTPUT_TRUNCATED nhan tran chu voi he so nay
TOKENS_PER_WORD=2.8                # do duoc 2.557 tren gemini-3.8-flash + bien 10%
SCENE_DESCRIPTION_MAX_WORDS=30     # hang cua service, khong phai truong `limits` backend gui

# ---- Anh (docs/06): mock, hoac ten profile trong app/image_models.yaml ---------
# That: IMAGE_PROFILE_PORTRAIT=IMAGE_PROFILE_SCENE=cf-flux-2-klein-4b + CLOUDFLARE_* +
# IMAGE_SAFETY=human_review (khong co bo phan loai; docs/01 2026-10-19). Ca hai mock hoac ca hai that.
IMAGE_PROFILE_PORTRAIT=mock
IMAGE_PROFILE_SCENE=mock
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_SAFETY=classifier
IMAGE_SCENE_WIDTH=1024
IMAGE_SCENE_HEIGHT=768

# ---- Storage: de trong SUPABASE_* thi dung LocalStorage (/tmp trong container) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=story-assets

# ---- Gia de uoc tinh estimated_cost_micros (khong viet cung; gia nha cung cap doi) ----
PRICE_TEXT_INPUT_PER_MTOK_MICROS=0
PRICE_TEXT_OUTPUT_PER_MTOK_MICROS=0

LOG_LEVEL=INFO
