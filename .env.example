# ==============================================================
# StoryWeaver AI - Environment Variables
# Copy this file to .env and fill in the values
# ==============================================================

# ---- App ----
NODE_ENV=development
PORT=3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://user:password@localhost:5432/storyweaver_dev?schema=public

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:3001
