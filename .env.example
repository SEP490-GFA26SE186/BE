# ==============================================================================
# StoryWeaver AI — backend. Copy file nay thanh .env roi dien gia tri.
#
#   cp .env.example .env
#
# docker-compose doc file .env nay va phan phoi bien cho tung service. Moi
# service chi nhan dung nhung bien no can — xem bang trong README.md.
# ==============================================================================

# ---- App ---------------------------------------------------------------------
NODE_ENV=development

# ---- Supabase (PostgreSQL) ---------------------------------------------------
# Lay o Supabase Dashboard > Project Settings > Database > Connection string.
# DATABASE_URL dung pooler (port 6543) cho runtime;
# DIRECT_URL dung ket noi truc tiep (port 5432) cho migration.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ---- JWT ---------------------------------------------------------------------
JWT_SECRET=doi-gia-tri-nay-truoc-khi-deploy
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS / URL --------------------------------------------------------------
CORS_ORIGIN=http://localhost:3001
APP_URL=http://localhost:3000

# ---- Email (Brevo) -----------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=StoryWeaver AI

# ---- Token noi bo giua worker va ai/ ----------------------------------------
# Chuoi bat ky, mien la giong nhau o hai service. KHONG phai JWT cua user.
INTERNAL_TOKEN=dev-internal-token-doi-truoc-khi-deploy

# ---- AI provider (service ai/) -----------------------------------------------
# Comment luon dat tren DONG RIENG: `VAR=   # ghi chu` co the bi doc thanh gia tri "# ghi chu".
#
# LLM_PROVIDER: mock = khong goi ben ngoai, tra truyen hop le theo khung request (di qua validator
#   that) — du de chay full luong end-to-end ma khong can API key. gemini = goi Gemini that (ton tien),
#   can GEMINI_API_KEY + GEMINI_TEXT_MODEL (model phai ton tai, kiem luc khoi dong).
#   claude = Anthropic API (ton tien), can ANTHROPIC_API_KEY + LLM_CLAUDE_MODEL trong container.
#   (claude_code chi chay ngoai Docker, tren may dev: xem ai/.env.example.)
LLM_PROVIDER=mock
# TTS_PROVIDER: hien chi co mock (vieneu: M5). Anh chi co mock toi M4b.
TTS_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
ANTHROPIC_API_KEY=
LLM_CLAUDE_MODEL=
# Trong = khong gui. LLM_CLAUDE_THINKING: disabled | adaptive | between_tools. LLM_CLAUDE_EFFORT: low..max
LLM_CLAUDE_THINKING=
LLM_CLAUDE_EFFORT=

# Tuy chon — de trong thi ai/ dung mac dinh (ai/app/config.py, ai/.env.example giai thich tung bien).
# Bat bien thoi gian: AI_TIMEOUT_MS_STORY_TEXT > 2 x LLM_TIMEOUT_SECONDS + overhead
# (mac dinh 320000 ms > 2 x 150 s). Doi mot ben thi kiem lai ben kia.
LLM_TIMEOUT_SECONDS=
LLM_TEMPERATURE=
LLM_RETRY_TEMPERATURE=
LLM_THINKING_BUDGET=
LLM_TRUNCATION_RETRY_FACTOR=
TOKENS_PER_WORD=
SCENE_DESCRIPTION_MAX_WORDS=
IMAGE_PROFILE_PORTRAIT=
IMAGE_PROFILE_SCENE=
# Gia de uoc tinh usage.estimated_cost_micros (de trong = 0).
PRICE_TEXT_INPUT_PER_MTOK_MICROS=
PRICE_TEXT_OUTPUT_PER_MTOK_MICROS=
LOG_LEVEL=

# ---- Luu file anh / audio (ai/ dung) -----------------------------------------
# Chon theo credential: du 3 bien CLOUDINARY_* -> Cloudinary; khong thi Supabase;
# khong co ca hai -> LocalStorage (/tmp trong container).
# Cloudinary: Dashboard > API Keys. File upload dang `authenticated` (khong co link
# cong khai). CLOUDINARY_FOLDER = thu muc goc trong tai khoan.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=storyweaver

# ---- Supabase Storage (ai/ dung, chi can quyen Storage) ----------------------
# De trong thi ai/ ghi file vao /tmp trong container (LocalStorage), du de chay
# thu. Dien vao khi muon file len that.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=story-assets

# ---- Tinh chinh queue / timeout (worker) -------------------------------------
# Timeout goi ai/ theo job (ms). De trong = mac dinh trong api/src/clients/aiClient.js:
# 320000 story_text, 90000 character_portrait / scene_image, 30000 narration.
AI_TIMEOUT_MS_STORY_TEXT=
AI_TIMEOUT_MS_CHARACTER_PORTRAIT=
AI_TIMEOUT_MS_SCENE_IMAGE=
AI_TIMEOUT_MS_NARRATION=
AI_JOB_ATTEMPTS=3
AI_WORKER_CONCURRENCY=3
#
# NFR 15s ("story page generation <= 15s via BullMQ") = DO TRE NHAN VIEC: tu luc phu huynh bam tao
# truyen toi luc giao dien phan hoi (request tra ngay sau khi enqueue, UI hien tien trinh). AI viet
# ca truyen mot lan; thoi gian sinh truyen la so do rieng (ai/scripts/try_story.py), khong phai NFR.
