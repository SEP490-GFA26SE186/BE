# ==============================================================================
# StoryWeaver AI — backend. Copy file nay thanh .env roi dien gia tri.
#
#   cp .env.example .env
#
# docker-compose doc file .env nay va phan phoi bien cho tung service. Moi
# service chi nhan dung nhung bien no can — xem bang trong README.md.
# ==============================================================================

# ---- App ---------------------------------------------------------------------
NODE_ENV=development

# ---- Supabase (PostgreSQL) ---------------------------------------------------
# Lay o Supabase Dashboard > Project Settings > Database > Connection string.
# DATABASE_URL dung pooler (port 6543) cho runtime;
# DIRECT_URL dung ket noi truc tiep (port 5432) cho migration.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ---- JWT ---------------------------------------------------------------------
JWT_SECRET=doi-gia-tri-nay-truoc-khi-deploy
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS / URL --------------------------------------------------------------
CORS_ORIGIN=http://localhost:3001
APP_URL=http://localhost:3000

# ---- Email (Brevo) -----------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=StoryWeaver AI

# ---- Token noi bo giua worker va services/ai ---------------------------------
# Chuoi bat ky, mien la giong nhau o hai service. KHONG phai JWT cua user.
INTERNAL_TOKEN=dev-internal-token-doi-truoc-khi-deploy

# ---- AI provider -------------------------------------------------------------
# mock  = khong goi provider that, tra du lieu gia dung cau truc envelope.
#         Du de chay full luong end-to-end ma khong can API key.
# gemini = CHUA HIEN THUC (xem services/ai/app/providers/gemini.py).
AI_PROVIDER=mock
GEMINI_API_KEY=

# ---- Supabase Storage (services/ai dung, chi can quyen Storage) --------------
# De trong thi services/ai ghi file vao /tmp trong container (LocalStorage), du
# de chay thu. Dien vao khi muon file len that.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=story-assets

# ---- Tinh chinh queue / timeout ----------------------------------------------
# Node cat o 12s, services/ai cat provider o 10s -> con cho cho ghi DB va day
# WebSocket ma van trong NFR 15s cho moi trang truyen.
AI_TIMEOUT_MS=12000
AI_JOB_ATTEMPTS=3
AI_WORKER_CONCURRENCY=3
