// =============================================================================
// StoryWeaver AI – Prisma Schema (PostgreSQL)
// SEP490 / SE186 – 54 models, 35 enums
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  admin
  moderator
  parent

  @@map("user_role")
}

enum AuthTokenType {
  refresh
  email_verify
  password_reset
  kid_session

  @@map("auth_token_type")
}

enum CharacterRole {
  self
  sibling
  parent
  relative
  pet
  toy

  @@map("character_role")
}

enum GenerationStatus {
  none
  queued
  generating
  ready
  failed

  @@map("generation_status")
}

enum TemplateStatus {
  draft
  active
  retired

  @@map("template_status")
}

enum StoryKind {
  private
  published

  @@map("story_kind")
}

enum StoryStatus {
  draft
  generating
  ready

  @@map("story_status")
}

enum PageKind {
  lead_in
  situation
  consequence
  ending

  @@map("page_kind")
}

enum ContentOrigin {
  human
  ai
  ai_edited

  @@map("content_origin")
}

enum PlayStatus {
  in_progress
  completed
  abandoned

  @@map("play_status")
}

enum AiRequestType {
  story_text
  page_rewrite
  character_portrait
  story_image
  narration

  @@map("ai_request_type")
}

enum AiRequestStatus {
  queued
  processing
  succeeded
  failed
  blocked

  @@map("ai_request_status")
}

enum QuotaSource {
  plan
  credit

  @@map("quota_source")
}

enum SellerStatus {
  pending
  approved
  rejected
  suspended

  @@map("seller_status")
}

enum ListingStatus {
  submitted
  in_review
  changes_requested
  rejected
  published
  suspended
  archived

  @@map("listing_status")
}

enum EntitlementSource {
  purchase
  free_claim
  admin_grant

  @@map("entitlement_source")
}

enum ReviewVisibility {
  visible
  hidden

  @@map("review_visibility")
}

enum ReviewTag {
  child_liked
  age_appropriate
  clear_lesson
  beautiful_art
  good_narration

  @@map("review_tag")
}

enum PlanPeriod {
  month
  year

  @@map("plan_period")
}

enum SubscriptionStatus {
  active
  expired
  cancelled

  @@map("subscription_status")
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
  expired

  @@map("order_status")
}

enum OrderItemType {
  plan
  credit_pack
  listing

  @@map("order_item_type")
}

enum OrderItemStatus {
  active
  refunded

  @@map("order_item_status")
}

enum VoucherDiscountType {
  percent
  fixed

  @@map("voucher_discount_type")
}

enum RequestStatus {
  pending
  approved
  rejected
  cancelled

  @@map("request_status")
}

enum WithdrawalStatus {
  requested
  paid
  rejected
  cancelled

  @@map("withdrawal_status")
}

enum WalletType {
  credit
  earning

  @@map("wallet_type")
}

enum LedgerEntryType {
  credit_topup
  credit_bonus
  credit_admin_grant
  credit_hold
  credit_release
  credit_consume
  earning_pending
  earning_release
  earning_reversal
  earning_to_credit
  withdrawal_hold
  withdrawal_paid
  withdrawal_release

  @@map("ledger_entry_type")
}

enum ModerationReviewType {
  submission
  random_audit
  report_followup

  @@map("moderation_review_type")
}

enum ModerationDecision {
  approved
  changes_requested
  rejected
  taken_down

  @@map("moderation_decision")
}

enum ReportCategory {
  scary
  violent
  inappropriate_lesson
  personal_info
  technical_error
  other

  @@map("report_category")
}

enum ReportStatus {
  open
  resolved
  dismissed

  @@map("report_status")
}

enum StrikeSource {
  report
  rejection
  takedown

  @@map("strike_source")
}

enum KeywordSeverity {
  block
  warn

  @@map("keyword_severity")
}

enum CaselCompetency {
  self_awareness
  self_management
  social_awareness
  relationship_skills
  responsible_decision_making

  @@map("casel_competency")
}

// =============================================================================
// 1. ACCOUNTS
// =============================================================================

/// @note kid_exit_pin_hash: NULL = chua dat PIN -> chan vao Kid Mode
model User {
  id              String    @id @default(uuid()) @db.Uuid
  role            UserRole  @default(parent)
  username        String    @unique @db.VarChar(50)
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String?   @map("full_name") @db.VarChar(150)
  phone           String?   @db.VarChar(20)
  kidExitPinHash  String?   @map("kid_exit_pin_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz()
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz()
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()

  // -- back-references --
  authTokens                AuthToken[]
  childProfiles             ChildProfile[]
  characters                Character[]
  notifications             Notification[]
  templatesCreated          Template[]          @relation("TemplateCreator")
  backgroundsCreated        Background[]        @relation("BackgroundCreator")
  blockedKeywordsCreated    BlockedKeyword[]     @relation("KeywordCreator")
  stories                   Story[]
  sellerProfile             SellerProfile?       @relation("SellerUser")
  sellerProfilesReviewed    SellerProfile[]      @relation("SellerReviewer")
  promptTemplatesCreated    PromptTemplate[]     @relation("PromptTemplateCreator")
  aiRequests                AiRequest[]
  cartItems                 CartItem[]
  entitlements              Entitlement[]
  productReviews            ProductReview[]      @relation("ReviewAuthor")
  hiddenReviews             ProductReview[]      @relation("ReviewHiddenBy")
  subscriptions             Subscription[]
  vouchersCreated           Voucher[]            @relation("VoucherCreator")
  orders                    Order[]
  voucherUsages             VoucherUsage[]
  refundRequestsMade        RefundRequest[]      @relation("RefundRequester")
  refundRequestsHandled     RefundRequest[]      @relation("RefundHandler")
  wallet                    Wallet?
  walletLedgerEntries       WalletLedger[]
  moderationReviews         ModerationReview[]   @relation("ModReviewModerator")
  contentReportsFiled       ContentReport[]      @relation("ReportReporter")
  contentReportsHandled     ContentReport[]      @relation("ReportHandler")
  creatorStrikesIssued      CreatorStrike[]      @relation("StrikeIssuer")
  strikeAppealsDecided      StrikeAppeal[]       @relation("AppealDecider")
  auditLogs                 AdminAuditLog[]
  platformSettingsUpdated   PlatformSetting[]    @relation("SettingUpdater")
  withdrawalRequestsHandled WithdrawalRequest[]  @relation("WithdrawalHandler")

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

/// @note CHECK: (type = kid_session) = (child_id IS NOT NULL)
/// @note CHECK: replaced_by_id IS NULL OR type = refresh
/// @note Partial unique: UNIQUE (child_id) WHERE type = kid_session AND consumed_at IS NULL
model AuthToken {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  type         AuthTokenType
  tokenHash    String        @unique @map("token_hash") @db.VarChar(255)
  replacedById String?       @map("replaced_by_id") @db.Uuid
  childId      String?       @map("child_id") @db.Uuid
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz()
  consumedAt   DateTime?     @map("consumed_at") @db.Timestamptz()
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthToken?    @relation("TokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  child      ChildProfile? @relation(fields: [childId], references: [id], onDelete: Cascade)

  // -- self back-reference --
  previousTokens AuthToken[] @relation("TokenReplacement")

  @@index([userId, type])
  @@index([expiresAt])
  @@index([childId])
  @@map("auth_tokens")
}

model ChildProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  parentId               String    @map("parent_id") @db.Uuid
  name                   String    @db.VarChar(100)
  birthDate              DateTime? @map("birth_date") @db.Date
  dailyScreenTimeMinutes Int       @default(30) @map("daily_screen_time_minutes")
  bedtimeStart           DateTime? @map("bedtime_start") @db.Time()
  bedtimeEnd             DateTime? @map("bedtime_end") @db.Time()
  preferredVoice         String?   @map("preferred_voice") @db.VarChar(50)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz()

  parent User @relation(fields: [parentId], references: [id], onDelete: Restrict)

  // -- back-references --
  authTokens        AuthToken[]
  characters        Character[]
  usageSessions     ChildUsageSession[]
  bookshelfItems    BookshelfItem[]
  playSessions      PlaySession[]

  @@index([parentId])
  @@map("child_profiles")
}

/// @note CHECK: role <> 'self' OR child_id IS NOT NULL
/// @note portrait_image_key: chan dung AI da duoc phu huynh chon, dung lam anh tham chieu
model Character {
  id               String           @id @default(uuid()) @db.Uuid
  parentId         String           @map("parent_id") @db.Uuid
  childId          String?          @map("child_id") @db.Uuid
  name             String           @db.VarChar(100)
  role             CharacterRole
  appearance       String
  portraitImageKey  String?          @map("portrait_image_key") @db.VarChar(300)
  genPrompt        String?          @map("gen_prompt")
  genSeed          BigInt?          @map("gen_seed")
  portraitStatus   GenerationStatus @default(none) @map("portrait_status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz()

  parent User          @relation(fields: [parentId], references: [id], onDelete: Restrict)
  child  ChildProfile? @relation(fields: [childId], references: [id], onDelete: SetNull)

  // -- back-references --
  storyCharacters StoryCharacter[]
  aiRequests      AiRequest[]

  @@index([parentId])
  @@index([childId])
  @@map("characters")
}

/// @note duration_seconds: GENERATED ALWAYS AS (extract(epoch from ended_at - started_at)::int) STORED
/// @note usage_date: GENERATED ALWAYS AS ((started_at AT TIME ZONE 'Asia/Ho_Chi_Minh')::date) STORED
model ChildUsageSession {
  id              String    @id @default(uuid()) @db.Uuid
  childId         String    @map("child_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  endedAt         DateTime? @map("ended_at") @db.Timestamptz()
  durationSeconds Int?      @map("duration_seconds")
  usageDate       DateTime  @map("usage_date") @db.Date

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, usageDate])
  @@map("child_usage_sessions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(200)
  body      String?
  refType   String?   @map("ref_type") @db.VarChar(50)
  refId     String?   @map("ref_id") @db.Uuid
  readAt    DateTime? @map("read_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// =============================================================================
// 2. CONTENT LIBRARY (Moderator quan ly)
// =============================================================================

model EqSkill {
  id           String           @id @default(uuid()) @db.Uuid
  caselCode    CaselCompetency  @unique @map("casel_code")
  nameVi       String           @map("name_vi") @db.VarChar(100)
  nameEn       String           @map("name_en") @db.VarChar(100)
  description  String
  displayOrder Int              @default(0) @map("display_order")

  // -- back-references --
  templates             Template[]
  templateChoiceSignals TemplateChoiceSignal[]
  eqScores              EqScore[]

  @@map("eq_skills")
}

/// @note Khuon su pham: bo xuong truyen, chua co chu. CHECK age_min <= age_max
model Template {
  id             String         @id @default(uuid()) @db.Uuid
  title          String         @db.VarChar(200)
  description    String?
  primarySkillId String         @map("primary_skill_id") @db.Uuid
  ageMin         Int            @default(5) @map("age_min")
  ageMax         Int            @default(8) @map("age_max")
  status         TemplateStatus @default(draft)
  createdById    String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  primarySkill EqSkill @relation(fields: [primarySkillId], references: [id], onDelete: Restrict)
  createdBy    User    @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // -- back-references --
  stages  TemplateStage[]
  slots   TemplateSlot[]
  stories Story[]

  @@index([status, primarySkillId])
  @@map("templates")
}

model TemplateStage {
  id                String  @id @default(uuid()) @db.Uuid
  templateId        String  @map("template_id") @db.Uuid
  stageOrder        Int     @map("stage_order")
  learningObjective String  @map("learning_objective")
  emotionToName     String? @map("emotion_to_name") @db.VarChar(50)
  leadInPages       Int     @default(1) @map("lead_in_pages")
  isClimax          Boolean @default(false) @map("is_climax")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // -- back-references --
  choiceTypes TemplateChoiceType[]
  storyPages  StoryPage[]

  @@unique([templateId, stageOrder])
  @@map("template_stages")
}

/// @note choice_order: 1=A, 2=B, 3=C
/// @note type_code: BUNG_NO | DUNG_LAI | BO_DI ...
model TemplateChoiceType {
  id          String  @id @default(uuid()) @db.Uuid
  stageId     String  @map("stage_id") @db.Uuid
  choiceOrder Int     @map("choice_order")
  typeCode    String  @map("type_code") @db.VarChar(40)
  description String
  isProsocial Boolean @default(false) @map("is_prosocial")

  stage TemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  // -- back-references --
  choiceSignals TemplateChoiceSignal[]
  storyChoices  StoryChoice[]

  @@unique([stageId, choiceOrder])
  @@map("template_choice_types")
}

/// @note Tin hieu ky nang do Moderator gan -> bao cao EQ khong dua vao nhan AI
model TemplateChoiceSignal {
  choiceTypeId String @map("choice_type_id") @db.Uuid
  skillId      String @map("skill_id") @db.Uuid
  delta        Int

  choiceType TemplateChoiceType @relation(fields: [choiceTypeId], references: [id], onDelete: Cascade)
  skill      EqSkill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([choiceTypeId, skillId])
  @@map("template_choice_signals")
}

/// @note slot_key: {CON} | {EM} | {ME} | {THU_CUNG} ...
model TemplateSlot {
  templateId    String        @map("template_id") @db.Uuid
  slotKey       String        @map("slot_key") @db.VarChar(30)
  characterRole CharacterRole @map("character_role")
  defaultName   String        @map("default_name") @db.VarChar(100)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, slotKey])
  @@map("template_slots")
}

/// @note Thu vien nen mac dinh, dung khi use_ai_image = false
model Background {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  imageKey    String   @map("image_key") @db.VarChar(300)
  tags        String?  @db.VarChar(200)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  createdBy User @relation("BackgroundCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // -- back-references --
  storyPages StoryPage[]

  @@map("backgrounds")
}

model UiAudioAsset {
  id          String @id @default(uuid()) @db.Uuid
  key         String @db.VarChar(80)
  lang        String @default("vi") @db.VarChar(10)
  textContent String @map("text_content")
  audioKey    String @map("audio_key") @db.VarChar(300)

  @@unique([key, lang])
  @@map("ui_audio_assets")
}

model BlockedKeyword {
  id          String          @id @default(uuid()) @db.Uuid
  keyword     String          @unique @db.VarChar(100)
  severity    KeywordSeverity @default(block)
  isActive    Boolean         @default(true) @map("is_active")
  createdById String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  createdBy User @relation("KeywordCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("blocked_keywords")
}

/// @note 7 nguyen tac su pham
model ChecklistItem {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique @db.VarChar(40)
  description  String
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  // -- back-references --
  reviewResults ReviewChecklistResult[]

  @@map("checklist_items")
}

// =============================================================================
// 3. STORIES
// =============================================================================

/// @note private: truyen phu huynh tao cho con minh, sua tu do
/// @note published: ban sao da go ca nhan hoa de ban; dong bang sau khi duyet
/// @note CHECK: kind <> 'published' OR source_story_id IS NOT NULL
model Story {
  id            String      @id @default(uuid()) @db.Uuid
  ownerId       String      @map("owner_id") @db.Uuid
  kind          StoryKind   @default(private)
  templateId    String      @map("template_id") @db.Uuid
  sourceStoryId String?     @map("source_story_id") @db.Uuid
  title         String      @db.VarChar(200)
  coverImageKey String?     @map("cover_image_key") @db.VarChar(300)
  useAiImage    Boolean     @default(false) @map("use_ai_image")
  useTts        Boolean     @default(true) @map("use_tts")
  status        StoryStatus @default(draft)
  reviewedAt    DateTime?   @map("reviewed_at") @db.Timestamptz()
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz()

  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  template    Template  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sourceStory Story?    @relation("StorySource", fields: [sourceStoryId], references: [id], onDelete: SetNull)

  // -- back-references --
  derivedStories  Story[]          @relation("StorySource")
  storyCharacters StoryCharacter[]
  pages           StoryPage[]
  bookshelfItems  BookshelfItem[]
  playSessions    PlaySession[]
  aiRequests      AiRequest[]
  listing         Listing?         @relation("ListingStory")

  @@index([ownerId, kind])
  @@map("stories")
}

/// @note character_id: chi dung cho truyen private; truyen published dung default_name cua khuon
model StoryCharacter {
  storyId     String  @map("story_id") @db.Uuid
  slotKey     String  @map("slot_key") @db.VarChar(30)
  characterId String? @map("character_id") @db.Uuid

  story     Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@id([storyId, slotKey])
  @@index([characterId])
  @@map("story_characters")
}

model StoryPage {
  id             String           @id @default(uuid()) @db.Uuid
  storyId        String           @map("story_id") @db.Uuid
  stageId        String           @map("stage_id") @db.Uuid
  pageKind       PageKind         @map("page_kind")
  pageOrder      Int              @map("page_order")
  fromChoiceId   String?          @unique @map("from_choice_id") @db.Uuid
  contentText    String?          @map("content_text")
  aiOriginalText String?          @map("ai_original_text")
  origin         ContentOrigin    @default(human)
  backgroundId   String?          @map("background_id") @db.Uuid
  imageKey       String?          @map("image_key") @db.VarChar(300)
  audioKey       String?          @map("audio_key") @db.VarChar(300)
  imageStatus    GenerationStatus @default(none) @map("image_status")
  audioStatus    GenerationStatus @default(none) @map("audio_status")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  story      Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  stage      TemplateStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  fromChoice StoryChoice?   @relation("ChoiceConsequence", fields: [fromChoiceId], references: [id], onDelete: Cascade)
  background Background?    @relation(fields: [backgroundId], references: [id], onDelete: Restrict)

  // -- back-references --
  choices             StoryChoice[]     @relation("PageChoices")
  playDecisions       PlayDecision[]
  aiRequests          AiRequest[]
  currentPlaySessions PlaySession[]     @relation("CurrentPage")
  reviewPageViews     ReviewPageView[]
  contentReports      ContentReport[]

  @@unique([storyId, pageOrder])
  @@index([stageId])
  @@map("story_pages")
}

model StoryChoice {
  id           String @id @default(uuid()) @db.Uuid
  pageId       String @map("page_id") @db.Uuid
  choiceOrder  Int    @map("choice_order")
  choiceText   String @map("choice_text")
  choiceTypeId String @map("choice_type_id") @db.Uuid
  audioKey     String? @map("audio_key") @db.VarChar(300)

  page       StoryPage          @relation("PageChoices", fields: [pageId], references: [id], onDelete: Cascade)
  choiceType TemplateChoiceType @relation(fields: [choiceTypeId], references: [id], onDelete: Restrict)

  // -- back-references --
  consequencePage StoryPage?    @relation("ChoiceConsequence")
  playDecisions   PlayDecision[]

  @@unique([pageId, choiceOrder])
  @@map("story_choices")
}

model BookshelfItem {
  childId String   @map("child_id") @db.Uuid
  storyId String   @map("story_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz()

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  story Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([childId, storyId])
  @@map("bookshelf_items")
}

// =============================================================================
// 4. LEARNING
// =============================================================================

model PlaySession {
  id             String     @id @default(uuid()) @db.Uuid
  childId        String     @map("child_id") @db.Uuid
  storyId        String     @map("story_id") @db.Uuid
  status         PlayStatus @default(in_progress)
  isReplay       Boolean    @default(false) @map("is_replay")
  currentPageId  String?    @map("current_page_id") @db.Uuid
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz()
  lastActivityAt DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz()
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz()

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Restrict)
  story       Story        @relation(fields: [storyId], references: [id], onDelete: Restrict)
  currentPage StoryPage?   @relation("CurrentPage", fields: [currentPageId], references: [id], onDelete: SetNull)

  // -- back-references --
  decisions    PlayDecision[]
  eqAssessment EqAssessment?

  @@index([childId, status])
  @@index([storyId, status])
  @@map("play_sessions")
}

model PlayDecision {
  id             BigInt   @id @default(autoincrement())
  sessionId      String   @map("session_id") @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  choiceId       String   @map("choice_id") @db.Uuid
  timeToDecideMs Int?     @map("time_to_decide_ms")
  replayCount    Int      @default(0) @map("replay_count")
  decidedAt      DateTime @default(now()) @map("decided_at") @db.Timestamptz()

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  page    StoryPage   @relation(fields: [pageId], references: [id], onDelete: Restrict)
  choice  StoryChoice @relation(fields: [choiceId], references: [id], onDelete: Restrict)

  @@unique([sessionId, pageId])
  @@map("play_decisions")
}

model EqAssessment {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @unique @map("session_id") @db.Uuid
  summaryVi  String?  @map("summary_vi")
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz()

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // -- back-references --
  scores EqScore[]

  @@map("eq_assessments")
}

/// @note CHECK: prosocial_choices <= occurrences; score BETWEEN 0 AND 100
model EqScore {
  id              BigInt @id @default(autoincrement())
  assessmentId    String @map("assessment_id") @db.Uuid
  skillId         String @map("skill_id") @db.Uuid
  occurrences     Int    @default(0)
  prosocialChoices Int   @default(0) @map("prosocial_choices")
  score           Int?

  assessment EqAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skill      EqSkill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, skillId])
  @@map("eq_scores")
}

// =============================================================================
// 5. AI
// =============================================================================

/// @note Partial unique: UNIQUE (request_type) WHERE is_active
model PromptTemplate {
  id          String        @id @default(uuid()) @db.Uuid
  requestType AiRequestType @map("request_type")
  version     String        @db.VarChar(30)
  templateText String       @map("template_text")
  modelName   String        @map("model_name") @db.VarChar(100)
  isActive    Boolean       @default(false) @map("is_active")
  activatedAt DateTime?     @map("activated_at") @db.Timestamptz()
  createdById String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  createdBy User @relation("PromptTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // -- back-references --
  aiRequests AiRequest[]

  @@unique([requestType, version])
  @@map("prompt_templates")
}

/// @note Han muc goi = COUNT(*) WHERE quota_source = plan trong ky subscription
/// @note CHECK: attempts <= 3
model AiRequest {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  requestType      AiRequestType   @map("request_type")
  storyId          String?         @map("story_id") @db.Uuid
  pageId           String?         @map("page_id") @db.Uuid
  characterId      String?         @map("character_id") @db.Uuid
  promptTemplateId String?         @map("prompt_template_id") @db.Uuid
  provider         String          @default("mock") @db.VarChar(40)
  modelName        String?         @map("model_name") @db.VarChar(100)
  status           AiRequestStatus @default(queued)
  quotaSource      QuotaSource     @map("quota_source")
  creditsCharged   Int             @default(0) @map("credits_charged")
  inputTokens      Int?            @map("input_tokens")
  outputTokens     Int?            @map("output_tokens")
  outputUnits      Int?            @map("output_units")
  providerCostMicros BigInt        @default(0) @map("provider_cost_micros")
  attempts         Int             @default(0)
  lockedAt         DateTime?       @map("locked_at") @db.Timestamptz()
  errorMessage     String?         @map("error_message")
  idempotencyKey   String          @unique @map("idempotency_key") @db.VarChar(120)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  finishedAt       DateTime?       @map("finished_at") @db.Timestamptz()

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  story          Story?          @relation(fields: [storyId], references: [id], onDelete: SetNull)
  page           StoryPage?      @relation(fields: [pageId], references: [id], onDelete: SetNull)
  character      Character?      @relation(fields: [characterId], references: [id], onDelete: SetNull)
  promptTemplate PromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([storyId])
  @@map("ai_requests")
}

// =============================================================================
// 6. MARKETPLACE
// =============================================================================

model SellerProfile {
  userId              String       @id @map("user_id") @db.Uuid
  displayName         String       @map("display_name") @db.VarChar(100)
  bio                 String?
  expertise           String?
  status              SellerStatus @default(pending)
  reviewedById        String?      @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?    @map("reviewed_at") @db.Timestamptz()
  bankName            String?      @map("bank_name") @db.VarChar(100)
  bankAccountNumber   String?      @map("bank_account_number") @db.VarChar(255)
  bankAccountHolder   String?      @map("bank_account_holder") @db.VarChar(150)
  bankUpdatedAt       DateTime?    @map("bank_updated_at") @db.Timestamptz()
  totalSales          Int          @default(0) @map("total_sales")
  ratingAvg           Decimal?     @map("rating_avg") @db.Decimal(3, 2)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user       User  @relation("SellerUser", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("SellerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // -- back-references --
  listings           Listing[]
  creatorStrikes     CreatorStrike[]
  withdrawalRequests WithdrawalRequest[]

  @@map("seller_profiles")
}

model PriceTier {
  id       String  @id @default(uuid()) @db.Uuid
  label    String  @db.VarChar(50)
  priceVnd BigInt  @unique @map("price_vnd")
  isActive Boolean @default(true) @map("is_active")

  // -- back-references --
  listings Listing[]

  @@map("price_tiers")
}

/// @note Bo dem cap nhat trong cung transaction + cron doi soat hang dem
model Listing {
  id                String        @id @default(uuid()) @db.Uuid
  sellerId          String        @map("seller_id") @db.Uuid
  publishedStoryId  String        @unique @map("published_story_id") @db.Uuid
  previousListingId String?       @map("previous_listing_id") @db.Uuid
  title             String        @db.VarChar(200)
  description       String?
  coverImageKey     String?       @map("cover_image_key") @db.VarChar(300)
  priceTierId       String        @map("price_tier_id") @db.Uuid
  status            ListingStatus @default(submitted)
  hasAiContent      Boolean       @default(false) @map("has_ai_content")
  purchaseCount     Int           @default(0) @map("purchase_count")
  freeClaimCount    Int           @default(0) @map("free_claim_count")
  ratingAvg         Decimal?      @map("rating_avg") @db.Decimal(3, 2)
  ratingCount       Int           @default(0) @map("rating_count")
  submittedAt       DateTime      @default(now()) @map("submitted_at") @db.Timestamptz()
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz()
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  seller          SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Restrict)
  publishedStory  Story         @relation("ListingStory", fields: [publishedStoryId], references: [id], onDelete: Restrict)
  previousListing Listing?      @relation("ListingVersion", fields: [previousListingId], references: [id], onDelete: SetNull)
  priceTier       PriceTier     @relation(fields: [priceTierId], references: [id], onDelete: Restrict)

  // -- back-references --
  nextListings      Listing[]          @relation("ListingVersion")
  cartItems         CartItem[]
  entitlements      Entitlement[]
  productReviews    ProductReview[]
  moderationReviews ModerationReview[]
  contentReports    ContentReport[]
  orderItems        OrderItem[]

  @@index([status, publishedAt])
  @@index([sellerId])
  @@map("listings")
}

model CartItem {
  parentId  String   @map("parent_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz()

  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([parentId, listingId])
  @@map("cart_items")
}

/// @note Partial unique: UNIQUE (parent_id, listing_id) WHERE revoked_at IS NULL
model Entitlement {
  id          String            @id @default(uuid()) @db.Uuid
  parentId    String            @map("parent_id") @db.Uuid
  listingId   String            @map("listing_id") @db.Uuid
  source      EntitlementSource
  orderItemId String?           @map("order_item_id") @db.Uuid
  grantedAt   DateTime          @default(now()) @map("granted_at") @db.Timestamptz()
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz()

  parent    User       @relation(fields: [parentId], references: [id], onDelete: Restrict)
  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@map("entitlements")
}

/// @note CHECK rating BETWEEN 1 AND 5
/// @note Chi nguoi da mua va con da nghe het moi duoc danh gia
model ProductReview {
  id              String           @id @default(uuid()) @db.Uuid
  listingId       String           @map("listing_id") @db.Uuid
  parentId        String           @map("parent_id") @db.Uuid
  rating          Int
  comment         String?
  visibility      ReviewVisibility @default(visible)
  hiddenById      String?          @map("hidden_by") @db.Uuid
  sellerReply     String?          @map("seller_reply")
  sellerRepliedAt DateTime?        @map("seller_replied_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  parent   User    @relation("ReviewAuthor", fields: [parentId], references: [id], onDelete: Restrict)
  hiddenBy User?   @relation("ReviewHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  // -- back-references --
  tags           ProductReviewTag[]
  contentReports ContentReport[]

  @@unique([listingId, parentId])
  @@index([listingId, visibility])
  @@map("product_reviews")
}

model ProductReviewTag {
  reviewId String    @map("review_id") @db.Uuid
  tag      ReviewTag

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, tag])
  @@map("product_review_tags")
}

// =============================================================================
// 7. COMMERCE & WALLET
// =============================================================================

model Plan {
  id             String     @id @default(uuid()) @db.Uuid
  code           String     @unique @db.VarChar(40)
  name           String     @db.VarChar(100)
  period         PlanPeriod
  priceVnd       BigInt     @map("price_vnd")
  aiStoryQuota   Int        @map("ai_story_quota")
  aiImageQuota   Int        @map("ai_image_quota")
  maxChildren    Int        @map("max_children")
  maxCharacters  Int        @map("max_characters")
  canSell        Boolean    @default(false) @map("can_sell")
  isActive       Boolean    @default(true) @map("is_active")

  // -- back-references --
  subscriptions Subscription[]
  orderItems    OrderItem[]

  @@map("plans")
}

/// @note Tra truoc, gia han thu cong. Partial unique: UNIQUE (parent_id) WHERE status = 'active'
model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  parentId    String             @map("parent_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  orderItemId String?            @map("order_item_id") @db.Uuid
  periodStart DateTime           @map("period_start") @db.Timestamptz()
  periodEnd   DateTime           @map("period_end") @db.Timestamptz()
  status      SubscriptionStatus @default(active)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  parent    User       @relation(fields: [parentId], references: [id], onDelete: Restrict)
  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([parentId, status])
  @@index([status, periodEnd])
  @@map("subscriptions")
}

model CreditPack {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(120)
  credits      Int
  bonusCredits Int     @default(0) @map("bonus_credits")
  priceVnd     BigInt  @map("price_vnd")
  isActive     Boolean @default(true) @map("is_active")

  // -- back-references --
  orderItems OrderItem[]

  @@map("credit_packs")
}

/// @note Voucher do nen tang chiu: doanh thu nguoi ban tinh tren gia niem yet
model Voucher {
  id            String              @id @default(uuid()) @db.Uuid
  code          String              @unique @db.VarChar(40)
  discountType  VoucherDiscountType @map("discount_type")
  value         BigInt
  maxDiscountVnd BigInt?            @map("max_discount_vnd")
  minOrderVnd   BigInt              @default(0) @map("min_order_vnd")
  startsAt      DateTime            @map("starts_at") @db.Timestamptz()
  endsAt        DateTime            @map("ends_at") @db.Timestamptz()
  usageLimit    Int?                @map("usage_limit")
  perUserLimit  Int                 @default(1) @map("per_user_limit")
  usedCount     Int                 @default(0) @map("used_count")
  isActive      Boolean             @default(true) @map("is_active")
  createdById   String              @map("created_by") @db.Uuid

  createdBy User @relation("VoucherCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // -- back-references --
  orders        Order[]
  voucherUsages VoucherUsage[]

  @@map("vouchers")
}

/// @note Webhook: UPDATE ... SET status = paid WHERE id = ? AND status = pending
model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  buyerId              String      @map("buyer_id") @db.Uuid
  voucherId            String?     @map("voucher_id") @db.Uuid
  subtotalVnd          BigInt      @map("subtotal_vnd")
  discountVnd          BigInt      @default(0) @map("discount_vnd")
  totalVnd             BigInt      @map("total_vnd")
  status               OrderStatus @default(pending)
  payosOrderCode       BigInt      @unique @map("payos_order_code")
  payosPaymentLinkId   String?     @map("payos_payment_link_id") @db.VarChar(100)
  payosTransactionId   String?     @unique @map("payos_transaction_id") @db.VarChar(100)
  paidAt               DateTime?   @map("paid_at") @db.Timestamptz()
  expiresAt            DateTime    @map("expires_at") @db.Timestamptz()
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  buyer   User     @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  // -- back-references --
  items         OrderItem[]
  voucherUsages VoucherUsage[]

  @@index([buyerId, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

/// @note CHECK exclusive arc: plan -> plan_id; credit_pack -> credit_pack_id; listing -> listing_id
model OrderItem {
  id              String          @id @default(uuid()) @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  itemType        OrderItemType   @map("item_type")
  planId          String?         @map("plan_id") @db.Uuid
  creditPackId    String?         @map("credit_pack_id") @db.Uuid
  listingId       String?         @map("listing_id") @db.Uuid
  unitPriceVnd    BigInt          @map("unit_price_vnd")
  creditsGranted  Int?            @map("credits_granted")
  bonusGranted    Int?            @map("bonus_granted")
  sellerShareRate Decimal?        @map("seller_share_rate") @db.Decimal(4, 3)
  sellerAmountVnd BigInt?         @map("seller_amount_vnd")
  status          OrderItemStatus @default(active)

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plan       Plan?       @relation(fields: [planId], references: [id], onDelete: Restrict)
  creditPack CreditPack? @relation(fields: [creditPackId], references: [id], onDelete: Restrict)
  listing    Listing?    @relation(fields: [listingId], references: [id], onDelete: Restrict)

  // -- back-references --
  subscriptions Subscription[]
  entitlements  Entitlement[]
  refundRequest RefundRequest?

  @@index([orderId])
  @@index([listingId])
  @@map("order_items")
}

model VoucherUsage {
  voucherId String   @map("voucher_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  usedAt    DateTime @default(now()) @map("used_at") @db.Timestamptz()

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([voucherId, orderId])
  @@index([voucherId, userId])
  @@map("voucher_usages")
}

/// @note Chi trong 7 ngay ke tu paid_at
model RefundRequest {
  id                 String        @id @default(uuid()) @db.Uuid
  orderItemId        String        @unique @map("order_item_id") @db.Uuid
  requesterId        String        @map("requester_id") @db.Uuid
  reason             String
  status             RequestStatus @default(pending)
  handledById        String?       @map("handled_by") @db.Uuid
  handledAt          DateTime?     @map("handled_at") @db.Timestamptz()
  bankTransactionRef String?       @map("bank_transaction_ref") @db.VarChar(100)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  requester User      @relation("RefundRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  handledBy User?     @relation("RefundHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@map("refund_requests")
}

model WebhookLog {
  id             BigInt   @id @default(autoincrement())
  provider       String   @default("payos") @db.VarChar(30)
  payosOrderCode BigInt?  @map("payos_order_code")
  payload        Json     @db.JsonB
  signatureValid Boolean  @map("signature_valid")
  processed      Boolean  @default(false)
  errorMessage   String?  @map("error_message")
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz()

  @@index([payosOrderCode])
  @@map("webhook_logs")
}

/// @note CHECK moi cot >= 0. Cap nhat bang SELECT ... FOR UPDATE.
/// @note Bat bien: moi so du = tong wallet_ledger tuong ung. Credit khong bao gio doi ra tien.
model Wallet {
  userId            String   @id @map("user_id") @db.Uuid
  creditBalance     Int      @default(0) @map("credit_balance")
  earningPendingVnd BigInt   @default(0) @map("earning_pending_vnd")
  earningAvailableVnd BigInt @default(0) @map("earning_available_vnd")
  earningLockedVnd  BigInt   @default(0) @map("earning_locked_vnd")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("wallets")
}

/// @note APPEND-ONLY. REVOKE UPDATE, DELETE
model WalletLedger {
  id             BigInt          @id @default(autoincrement())
  userId         String          @map("user_id") @db.Uuid
  walletType     WalletType      @map("wallet_type")
  entryType      LedgerEntryType @map("entry_type")
  amount         BigInt
  balanceAfter   BigInt          @map("balance_after")
  availableAt    DateTime?       @map("available_at") @db.Timestamptz()
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(120)
  refType        String?         @map("ref_type") @db.VarChar(50)
  refId          String?         @map("ref_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, walletType, createdAt])
  @@index([refType, refId])
  @@index([entryType, availableAt])
  @@map("wallet_ledger")
}

/// @note CHECK amount_vnd >= muc toi thieu (platform_settings)
/// @note Partial unique: UNIQUE (seller_id) WHERE status = 'requested'
model WithdrawalRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  sellerId           String           @map("seller_id") @db.Uuid
  amountVnd          BigInt           @map("amount_vnd")
  bankSnapshot       Json             @map("bank_snapshot") @db.JsonB
  status             WithdrawalStatus @default(requested)
  handledById        String?          @map("handled_by") @db.Uuid
  handledAt          DateTime?        @map("handled_at") @db.Timestamptz()
  bankTransactionRef String?          @map("bank_transaction_ref") @db.VarChar(100)
  rejectReason       String?          @map("reject_reason")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  seller    SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Restrict)
  handledBy User?         @relation("WithdrawalHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([sellerId])
  @@map("withdrawal_requests")
}

/// @note key: commission_rate | holding_days | min_withdrawal | report_threshold | ai_cost.<type>
model PlatformSetting {
  key       String   @id @db.VarChar(60)
  value     Json     @db.JsonB
  updatedById String @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  updatedBy User @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("platform_settings")
}

// =============================================================================
// 8. MODERATION & MONITORING
// =============================================================================

/// @note Chi quyet dinh approved khi da xem 100% trang va tick du checklist
model ModerationReview {
  id             String                @id @default(uuid()) @db.Uuid
  listingId      String                @map("listing_id") @db.Uuid
  reviewType     ModerationReviewType  @map("review_type")
  moderatorId    String?               @map("moderator_id") @db.Uuid
  claimedAt      DateTime?             @map("claimed_at") @db.Timestamptz()
  claimExpiresAt DateTime?             @map("claim_expires_at") @db.Timestamptz()
  decision       ModerationDecision?
  comment        String?
  decidedAt      DateTime?             @map("decided_at") @db.Timestamptz()
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz()

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  moderator User?   @relation("ModReviewModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  // -- back-references --
  checklistResults ReviewChecklistResult[]
  pageViews        ReviewPageView[]

  @@index([decidedAt, createdAt])
  @@index([listingId])
  @@map("moderation_reviews")
}

model ReviewChecklistResult {
  reviewId        String @map("review_id") @db.Uuid
  checklistItemId String @map("checklist_item_id") @db.Uuid
  passed          Boolean

  review        ModerationReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem    @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)

  @@id([reviewId, checklistItemId])
  @@map("review_checklist_results")
}

model ReviewPageView {
  reviewId String   @map("review_id") @db.Uuid
  pageId   String   @map("page_id") @db.Uuid
  viewedAt DateTime @default(now()) @map("viewed_at") @db.Timestamptz()
  comment  String?

  review ModerationReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  page   StoryPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([reviewId, pageId])
  @@map("review_page_views")
}

/// @note CHECK: dung mot trong listing_id / product_review_id
/// @note Partial unique: UNIQUE (reporter_id, listing_id) WHERE listing_id IS NOT NULL
/// @note Tu tam go: >= N nguoi bao cao khac nhau trong 24 gio -> listing suspended
model ContentReport {
  id              String         @id @default(uuid()) @db.Uuid
  reporterId      String         @map("reporter_id") @db.Uuid
  listingId       String?        @map("listing_id") @db.Uuid
  pageId          String?        @map("page_id") @db.Uuid
  productReviewId String?        @map("product_review_id") @db.Uuid
  category        ReportCategory
  description     String?
  status          ReportStatus   @default(open)
  handledById     String?        @map("handled_by") @db.Uuid
  handledAt       DateTime?      @map("handled_at") @db.Timestamptz()
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  reporter      User           @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  listing       Listing?       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  page          StoryPage?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  productReview ProductReview? @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  handledBy     User?          @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([listingId, createdAt])
  @@map("content_reports")
}

/// @note 3 canh cao con hieu luc -> seller_profiles.status = suspended
model CreatorStrike {
  id        String       @id @default(uuid()) @db.Uuid
  sellerId  String       @map("seller_id") @db.Uuid
  source    StrikeSource
  sourceId  String?      @map("source_id") @db.Uuid
  reason    String
  issuedById String      @map("issued_by") @db.Uuid
  issuedAt  DateTime     @default(now()) @map("issued_at") @db.Timestamptz()
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  revokedAt DateTime?    @map("revoked_at") @db.Timestamptz()

  seller   SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Restrict)
  issuedBy User          @relation("StrikeIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  // -- back-references --
  appeal StrikeAppeal?

  @@index([sellerId, expiresAt])
  @@map("creator_strikes")
}

model StrikeAppeal {
  id           String        @id @default(uuid()) @db.Uuid
  strikeId     String        @unique @map("strike_id") @db.Uuid
  reason       String
  status       RequestStatus @default(pending)
  decidedById  String?       @map("decided_by") @db.Uuid
  decidedAt    DateTime?     @map("decided_at") @db.Timestamptz()
  decisionNote String?       @map("decision_note")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  strike    CreatorStrike @relation(fields: [strikeId], references: [id], onDelete: Cascade)
  decidedBy User?         @relation("AppealDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@map("strike_appeals")
}

model AdminAuditLog {
  id          BigInt   @id @default(autoincrement())
  actorId     String   @map("actor_id") @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String?  @map("target_type") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.Uuid
  beforeState Json?    @map("before_state") @db.JsonB
  afterState  Json?    @map("after_state") @db.JsonB
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
