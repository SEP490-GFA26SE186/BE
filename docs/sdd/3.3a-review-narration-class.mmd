%%{init: {"theme": "neutral", "themeVariables": {"fontFamily": "Arial"}}}%%
classDiagram
  direction TB
  class StoriesRoutes {
    <<router>>
    +POST /stories/:id/review [auth]
    +POST /stories/:id/narration/retry [auth]
  }
  class StoriesController {
    <<controller>>
    +reviewStory(req, res) void
    +retryNarration(req, res) void
  }
  class StoriesEditorService {
    <<service>>
    +reviewStory(user, storyId) Object
  }
  class StoriesNarrationService {
    <<service>>
    +prepareNarration(tx, storyId) Object
    +dispatchNarration(jobs) boolean
    +retryNarration(user, storyId) Object
  }
  class StoriesNarrationStore {
    <<store>>
    +loadVoice(db) String
    +queueNarration(tx, storyId, voice) Object
    +markClipGenerating(db, clipId, round, attempt) boolean
    +loadClipInput(db, clipId) Object
    +persistClip(db, clipResult) boolean
    +failClip(db, clipId, round, code, message) void
    +loadReadiness(db, storyId) Object
  }
  class NarrationRules {
    <<utility>>
    +findReviewGaps(pages, checkpoints) Object
    +storyStatusFromPages(pages) StoryStatus
    +narrationSegments(story) Object
    +fingerprintOf(text, voice) String
    +planNarration(segments, clips, voice) Object
    +childReadiness(story, clips, voice) Object
  }
  class NarrationQueue {
    <<queue>>
    +enqueueNarration(jobs) Object
  }
  class NarrationProcessor {
    <<worker>>
    +processNarrationJob(job) void
  }
  class AiClient {
    <<client>>
    +callAi(jobName, payload) Object
  }
  class AiService {
    <<external>>
    +POST /v1/tts/synthesize
  }
  class Story {
    <<entity>>
    -UUID id
    -UUID ownerId
    -StoryStatus status
    -boolean useTts
    -DateTime reviewedAt
  }
  class StoryPage {
    <<entity>>
    -UUID id
    -UUID storyId
    -int pageOrder
    -String contentText
    -String audioKey
    -GenerationStatus audioStatus
  }
  class NarrationClip {
    <<entity>>
    -UUID id
    -UUID storyId
    -String segment
    -String fingerprint
    -GenerationStatus status
    -int round
    -int attempts
    -String audioKey
    -Decimal durationSeconds
    -String errorCode
    -String errorMessage
  }

  StoriesRoutes ..> StoriesController : delegates
  StoriesController ..> StoriesEditorService : review story
  StoriesController ..> StoriesNarrationService : retry narration
  StoriesEditorService ..> NarrationRules : findReviewGaps
  StoriesEditorService ..> Story : sets reviewedAt
  StoriesEditorService ..> StoriesNarrationService : prepare + dispatch narration
  StoriesNarrationService ..> StoriesNarrationStore : queue / fail clips
  StoriesNarrationService ..> NarrationQueue : enqueues clip jobs
  StoriesNarrationStore ..> NarrationRules : segments / fingerprint / plan
  StoriesNarrationStore ..> NarrationClip : creates / updates
  StoriesNarrationStore ..> StoryPage : writes audioKey
  NarrationQueue ..> NarrationProcessor : delivers job (concurrency 1)
  NarrationProcessor ..> StoriesNarrationStore : mark / load / persist / fail
  NarrationProcessor ..> AiClient : calls narration
  AiClient ..> AiService : HTTP request
  Story "1" *-- "1..*" StoryPage : pages
  Story "1" *-- "0..*" NarrationClip : narrationClips
