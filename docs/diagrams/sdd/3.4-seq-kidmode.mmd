%%{init: {"theme": "neutral", "themeVariables": {"fontFamily": "Arial"}}}%%
sequenceDiagram
  autonumber
  actor P as Parent
  actor K as Child
  participant W as Web App
  participant C as :AuthController
  participant S as :AuthService
  participant L as :KidPinLimiter
  participant T as :TokenService
  participant DB as Database
  P->>W: Choose child, click Enter Kid Mode
  W->>+C: POST /api/v1/auth/kid-mode/enter {childId}
  C->>+S: enterKidMode(parentId, childId)
  S->>DB: SELECT parent (kid_exit_pin_hash), child (owned, not deleted)
  DB-->>S: User, ChildProfile
  alt PIN not set
    S-->>C: ApiError 403
    C-->>W: 403 Set a Kid Exit PIN first
  else child not owned
    S-->>C: ApiError 404
    C-->>W: 404 Child profile not found
  else ok
    S->>+T: generateKidSessionToken(parent, childId)
    T->>DB: INSERT auth_tokens (kid_session)
    T-->>-S: kid token
    S-->>C: kid token + child
    C-->>W: 200 kid session
  end
  deactivate S
  deactivate C
  K->>W: Read stories (every /kid/* call carries the kid token)
  P->>W: Enter Kid Exit PIN
  W->>+C: POST /api/v1/auth/kid-mode/exit {pin, kidSessionToken}
  C->>+S: exitKidMode(body)
  S->>+T: verifyKidSessionToken(token)
  T-->>-S: parent, token id
  S->>L: lockRemainingMs(parentId)
  L-->>S: remaining ms
  alt locked after 5 wrong PINs
    S-->>C: ApiError 429
    C-->>W: 429 Try again in 15 minutes
  else PIN wrong
    S->>L: recordFailure(parentId)
    S-->>C: ApiError 401 with attempts left
    C-->>W: 401 Wrong PIN
  else PIN correct
    S->>L: reset(parentId)
    S->>T: consumeKidSessionToken(tokenId)
    T->>DB: UPDATE auth_tokens SET consumed_at = now()
    S->>T: generateAuthTokens(parent)
    T-->>S: parent tokens
    S-->>C: parent + tokens
    C-->>W: 200
  end
  deactivate S
  deactivate C
  W-->>P: Back to Parent Dashboard / show error
