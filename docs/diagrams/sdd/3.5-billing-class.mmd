%%{init: {"theme": "neutral", "themeVariables": {"fontFamily": "Arial"}}}%%
classDiagram
  direction TB
  class BillingController {
    <<controller>>
    +checkoutPlan(req, res) void
    +getOrder(req, res) void
    +payosWebhook(req, res) void
  }
  class BillingService {
    <<service>>
    +listPlans() List~Plan~
    +checkoutPlan(user, planId) CheckoutResult
    +checkoutOrder(user, price, itemName, item, returnPath) CheckoutResult
    +getOrder(user, orderId) Order
    +handleWebhook(body) WebhookResult
  }
  class BillingStore {
    <<repository>>
    +fulfillOrder(tx, orderId) bool
    +closeOrder(tx, orderId, status) bool
    +ensureFreeSubscription(tx, parentId) Subscription
    +runBillingCycle(db, now) CycleResult
    -startPeriod(tx, parentId, plan, orderItemId) Subscription
    -deliverListing(tx, buyerId, item) void
  }
  class BillingRules {
    <<utility>>
    +newPeriod(plan, now) Period
    +cycleAction(subscription, now) CycleAction
    +newOrderCode() int
    +payosDescription(orderCode) string
  }
  class PayOSClient {
    <<external>>
    +paymentRequests.create(request) PaymentLink
    +paymentRequests.get(orderCode) PaymentInfo
    +webhooks.verify(body) WebhookData
  }
  class CreditLedger {
    <<repository>>
    +grantCredit(tx, userId, amount, key) void
    +expireCredit(tx, userId, key) void
  }
  class Plan {
    <<entity>>
    -UUID id
    -String code
    -BigInt priceVnd
    -Int durationMonths
    -Int creditsPerMonth
    -Boolean canSell
    -Boolean isActive
  }
  class Order {
    <<entity>>
    -UUID id
    -UUID buyerId
    -OrderStatus status
    -BigInt totalVnd
    -BigInt payosOrderCode
    -DateTime expiresAt
    -DateTime paidAt
  }
  class OrderItem {
    <<entity>>
    -UUID id
    -OrderItemType itemType
    -UUID planId
    -UUID listingId
    -BigInt unitPriceVnd
    -Decimal sellerShareRate
    -OrderItemStatus status
  }
  class Subscription {
    <<entity>>
    -UUID id
    -UUID parentId
    -UUID planId
    -SubscriptionStatus status
    -DateTime periodStart
    -DateTime periodEnd
    -DateTime nextCreditGrantAt
  }
  class WebhookLog {
    <<entity>>
    -BigInt payosOrderCode
    -Json payload
    -Boolean signatureValid
    -Boolean processed
  }
  class OrderStatus {
    <<enumeration>>
    pending
    paid
    failed
    cancelled
    expired
  }
  class SubscriptionStatus {
    <<enumeration>>
    active
    expired
    cancelled
  }

  BillingController --> BillingService : uses
  BillingService ..> PayOSClient : payment link, verify
  BillingService --> BillingStore : fulfil / close
  BillingStore ..> BillingRules : period rules
  BillingStore ..> CreditLedger : credit_grant / credit_expire
  BillingService ..> WebhookLog : logs every webhook
  BillingStore ..> Order : persists
  BillingStore ..> Subscription : persists
  Order "1" --> "1..*" OrderItem : items
  OrderItem "*" --> "0..1" Plan : plan item
  OrderItem "1" --> "0..1" Subscription : starts
  Subscription "*" --> "1" Plan
  Order --> OrderStatus
  Subscription --> SubscriptionStatus
