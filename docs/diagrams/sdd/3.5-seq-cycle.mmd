%%{init: {"theme": "neutral", "themeVariables": {"fontFamily": "Arial"}}}%%
sequenceDiagram
  autonumber
  participant CR as :Worker cron (every 15 min)
  participant ST as :BillingStore
  participant R as :BillingRules
  participant L as :CreditLedger
  participant DB as Database
  CR->>+ST: runBillingCycle(db, now)
  ST->>DB: SELECT subscriptions WHERE active AND next_credit_grant_at <= now
  DB-->>ST: due subscriptions
  loop each subscription
    ST->>R: cycleAction(subscription, now)
    R-->>ST: grant / renew_free / expire
    ST->>DB: BEGIN
    alt new month inside the period
      ST->>L: expireCredit(key expire:sub:month)
      ST->>L: grantCredit(creditsPerMonth, key grant:sub:month)
      ST->>DB: UPDATE subscriptions SET next_credit_grant_at
    else period ended
      ST->>L: expireCredit (left-over credit)
      ST->>DB: startPeriod(Free plan), old subscription expired
    end
    ST->>DB: COMMIT
  end
  ST->>DB: UPDATE orders SET expired WHERE pending AND expires_at < now
  ST-->>-CR: {granted, renewedFree, expired, ordersExpired}
  Note over ST,DB: Deterministic idempotency keys make two workers running together safe
