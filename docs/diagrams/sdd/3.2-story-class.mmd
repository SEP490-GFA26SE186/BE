classDiagram
  class StoriesRoutes {
    +POST analyze()
    +POST stories()
    +PUT cover(id)
    +PUT pages(pageId)
    +PUT checkpoints(cpId)
    +POST generate(id)
    +GET generation(id)
    +POST review(id)
  }
  class StoriesService {
    +createStory(user, body)
    +prepareFamily(user, body)
    +setCover(user, id, sceneId)
    +updateStory(user, id, body)
    +bindCharacters(user, id, ids)
    +tokenizeOrReject(text, ctx)
    +assertNoBlockedKeywords(tx, storyId)
  }
  class StoriesAnalysisService {
    +analyzeStory(user, body)
  }
  class AnalysisToken {
    +signAnalysisToken(payload)
    +verifyAnalysisToken(token, ownerId)
  }
  class StoriesEditorService {
    +addPage() deletePage()
    +addCheckpoint() deleteCheckpoint()
    +reviewStory(user, id)
  }
  class GenerationService {
    +startGeneration(user, storyId)
    +getGeneration(user, storyId)
    +getAiPricing()
  }
  class GenerationStore {
    +markProcessing(id, attempt)
    +loadGenerationInput(id)
    +persistAiResult(id, response)
    +finalizeFailure(id, code)
  }
  class CreditLedger {
    +holdCredit(tx, userId, amount, aiRequestId)
    +consumeCredit(tx, userId, aiRequestId)
    +releaseCredit(tx, userId, aiRequestId)
  }
  class AiQueue {
    +add(name, data, jobId)
  }
  class AiProcessor {
    +process(job)
  }
  class AiClient {
    +callAi(jobName, payload)
  }
  class Story {
    uuid id
    StoryKind kind
    StoryEntry entry
    StoryLength length
    StoryStatus status
    string situation
    string momentSummary
    bool scored
    uuid coverSceneId
    datetime reviewedAt
  }
  class AiRequest {
    uuid id
    AiRequestType requestType
    AiRequestStatus status
    int creditsCharged
    string idempotencyKey
  }
  StoriesRoutes --> StoriesService
  StoriesRoutes --> StoriesAnalysisService
  StoriesAnalysisService --> AnalysisToken
  StoriesAnalysisService --> AiClient : sync, no credit
  StoriesService --> AnalysisToken
  StoriesRoutes --> StoriesEditorService
  StoriesRoutes --> GenerationService
  GenerationService --> CreditLedger
  GenerationService --> AiQueue
  AiQueue --> AiProcessor
  AiProcessor --> GenerationStore
  AiProcessor --> AiClient
  GenerationStore --> CreditLedger
  class StorySubSkill {
    StorySubSkillSource source
    int position
  }
  Story "1" --> "*" AiRequest
  Story "1" --> "1..2" StorySubSkill : family entry
