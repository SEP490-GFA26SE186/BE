classDiagram
  class StoriesEditorService {
    +reviewStory(user, id)
  }
  class NarrationService {
    +prepareNarration(tx, storyId)
    +dispatchNarration(jobs)
    +retryNarration(user, storyId)
  }
  class NarrationStore {
    +loadReadiness(storyId)
    +queueNarration(tx, storyId)
    +persistClip(clipId, audio)
    +failClip(clipId)
  }
  class ImagesService {
    +startPortrait(user, characterId)
    +drawStoryImages(user, storyId)
    +redrawScene(user, storyId, sceneId)
    +resumeAfterPortrait(characterId)
  }
  class ImagesStore {
    +loadPortraitInput(id)
    +loadSceneInput(id)
    +persistImageResult(id, image)
    +finalizeImageFailure(id)
  }
  class NarrationProcessor
  class AiProcessor
  class AiService {
    +POST /v1/tts/synthesize
    +POST /v1/images/portrait
    +POST /v1/images/scene
  }
  class AssetUrl {
    +signedUrl(key)
  }
  class NarrationClip {
    uuid id
    int segmentOrder
    string fingerprint
    string audioKey
    GenerationStatus status
  }
  class StoryScene {
    uuid id
    int sceneOrder
    string description
    string imageKey
    GenerationStatus imageStatus
  }
  StoriesEditorService --> NarrationService : after review
  NarrationService --> NarrationStore
  NarrationProcessor --> NarrationStore
  ImagesService --> ImagesStore
  AiProcessor --> ImagesStore
  NarrationStore --> NarrationClip
  ImagesStore --> StoryScene
  NarrationProcessor --> AiService
  AiProcessor --> AiService
  AiService ..> Cloudinary : upload authenticated
  NarrationClip ..> AssetUrl : signed URL
