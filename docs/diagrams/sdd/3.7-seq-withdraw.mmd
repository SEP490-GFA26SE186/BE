sequenceDiagram
  actor S as Seller
  actor A as Admin
  participant API as WithdrawalsService
  participant DB as PostgreSQL
  participant PO as payOS Payout
  S->>API: POST /sellers/me/withdrawals {amountVnd}
  API->>DB: seller approved, bank set (>24h ago), amount >= minimum
  API->>DB: no open request, wallet FOR UPDATE, available >= amount
  API->>DB: available -= amount, withdrawal_hold, request(requested)
  API-->>S: 201
  A->>API: POST /admin/withdrawals/:id/approve
  API->>PO: payouts.create(bank, amount)
  alt payOS error
    API-->>A: 502 payOS did not accept
  end
  API->>DB: requested -> processing (bankTransactionRef)
  loop cron syncProcessingWithdrawals / Admin sync
    API->>PO: payouts.get(ref)
    alt succeeded
      API->>DB: processing -> paid, withdrawal_paid
    else failed
      API->>DB: rejected, withdrawal_release (money back)
    end
  end
