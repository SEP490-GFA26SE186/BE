%%{init: {"theme": "neutral", "themeVariables": {"fontFamily": "Arial"}}}%%
sequenceDiagram
  autonumber
  actor P as Parent
  participant W as Web App
  participant C as :BillingController
  participant S as :BillingService
  participant ST as :BillingStore
  participant DB as Database
  participant PO as payOS
  P->>W: Choose plan, click Pay
  W->>+C: POST /api/v1/payments/plans/checkout {planId}
  C->>+S: checkoutPlan(user, planId)
  S->>DB: SELECT plans WHERE id = ? AND is_active
  DB-->>S: Plan
  S->>DB: INSERT orders (pending, payos_order_code, expires_at) + order_items (price snapshot)
  DB-->>S: Order
  S->>+PO: paymentRequests.create(orderCode, amount, returnUrl, expiredAt)
  PO-->>-S: checkoutUrl / error
  alt payOS error
    S->>DB: UPDATE orders SET status = failed
    S-->>C: ApiError 503
    C-->>W: 503 Payment unavailable
  else link created
    S->>DB: UPDATE orders SET payos_payment_link_id
    S-->>C: {order, checkoutUrl}
    C-->>W: 201
  end
  deactivate S
  deactivate C
  W->>PO: Redirect, parent pays by VietQR
  PO->>+C: POST /api/v1/payments/payos/webhook
  C->>+S: handleWebhook(body)
  S->>PO: webhooks.verify(body)
  S->>DB: INSERT webhook_logs (signature_valid)
  alt invalid signature / unknown order / code != 00 / amount too low
    S-->>C: {processed: false, reason}
  else valid
    S->>+ST: fulfillOrder(tx, orderId)
    ST->>DB: UPDATE orders SET paid WHERE status IN (pending, expired)
    ST->>DB: startPeriod (or extend if same plan): close old period, credit_grant
    ST-->>-S: processed
    S->>DB: UPDATE webhook_logs SET processed
    S-->>C: {processed: true}
  end
  deactivate S
  C-->>-PO: 200
  PO-->>W: Redirect to /parent/billing/result?orderId
  W->>+C: GET /api/v1/payments/orders/:orderId
  C->>S: getOrder(user, orderId) (syncs with payOS if still pending)
  S-->>C: Order
  C-->>-W: 200 order status
  W-->>P: Show payment result
