classDiagram
  class SubSkillsService {
    +createSubSkill(user, body)
    +updateSubSkill(user, id, body)
    +deleteSubSkill(id)
  }
  class TopicsService {
    +createTopic(user, body)
    +updateTopic(id, body)
    +deleteTopic(id)
  }
  class QuestionTemplatesService {
    +createTemplate(user, body)
    +saveDraft(user, id, body)
    +publish(user, id)
    +deleteTemplate(id)
  }
  class TemplateRules {
    +assertVersionComplete(version)
    +checkpointTypeFor(format)
    +scoreFor(version, choice)
  }
  class CheckpointReviewService {
    +listQueue() markOk() flag() unflag()
  }
  class EqSubSkill {
    string code
    uuid skillId
    uuid caselReferenceId
    int ageMin
    int ageMax
  }
  class QuestionTemplate {
    string name
    bool isActive
  }
  class QuestionTemplateVersion {
    int version
    TemplateStatus status
    AnswerFormat answerFormat
    json options
  }
  class Topic {
    string title
    uuid skillId
    bool isActive
  }
  SubSkillsService --> EqSubSkill
  TopicsService --> Topic
  QuestionTemplatesService --> TemplateRules
  QuestionTemplate "1" --> "*" QuestionTemplateVersion
  EqSubSkill "1" --> "*" QuestionTemplate
  Topic "*" --> "1..3" EqSubSkill
