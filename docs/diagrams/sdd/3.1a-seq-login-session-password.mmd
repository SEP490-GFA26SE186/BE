---
title: "Sequence Diagram - Log In and Manage Password"
config:
  theme: neutral
  themeVariables:
    background: '#ffffff'
    noteBkgColor: '#ffffff'
    noteBorderColor: '#999999'
    noteTextColor: '#000000'
---
sequenceDiagram
  autonumber
  actor U as User
  participant W as Web App
  participant R as :AuthRoutes
  participant A as :AuthMiddleware
  participant C as :AuthController
  participant S as :AuthService
  participant T as :TokenService
  participant E as :EmailService
  participant DB as Database
  participant M as Brevo / SMTP

  Note over U,M: 1. Login
  U->>W: Enter email / username + password
  W->>R: POST /api/v1/auth/login
  R->>R: validate(AuthValidation.login)
  R->>C: login(req, res)
  C->>S: login(emailOrUsername, password)
  S->>DB: SELECT user by email or username
  alt not found / deleted / wrong password (bcrypt.compare)
    S-->>C: ApiError 401
    C-->>W: 401 Invalid email/username or password
  else account deactivated
    S-->>C: ApiError 403
    C-->>W: 403 Account has been deactivated
  else valid
    S->>DB: UPDATE users SET lastLoginAt
    S->>T: generateAuthTokens(user)
    T->>DB: INSERT auth_tokens (refresh, SHA-256 hash, 7d)
    T-->>S: accessToken (JWT 15m) + refreshToken
    S-->>C: user + tokens
    C-->>W: 200 user + tokens
    W-->>U: Redirect to role home
  end

  Note over U,M: 2. Refresh tokens and logout
  W->>R: POST /api/v1/auth/refresh-tokens {refreshToken} (access token expired)
  R->>C: refreshTokens(req, res)
  C->>S: refreshTokens(refreshToken)
  S->>T: verifyAndRotateRefreshToken(refreshToken)
  T->>DB: SELECT auth_tokens by hash (+ user)
  alt invalid / used / expired / user deactivated
    T-->>C: ApiError 401
    C-->>W: 401 Back to login page
  else valid
    T->>DB: BEGIN, INSERT new refresh token, UPDATE old SET consumedAt + replacedById, COMMIT
    T-->>C: user + new tokens
    C-->>W: 200 new tokens, retry original request
  end
  U->>W: Click Log out
  W->>R: POST /api/v1/auth/logout {refreshToken}
  R->>C: logout(req, res)
  C->>S: logout(refreshToken)
  S->>T: revokeRefreshToken(refreshToken)
  T->>DB: UPDATE auth_tokens SET consumedAt (if not consumed)
  C-->>W: 200 Logged out

  Note over U,M: 3. Forgot password and reset with code
  U->>W: Enter email on Forgot password page
  W->>R: POST /api/v1/auth/forgot-password {email}
  R->>C: forgotPassword(req, res)
  C->>S: forgotPassword(email)
  S->>DB: SELECT active user by email
  opt user exists
    S->>T: generatePasswordResetToken(userId)
    T->>DB: invalidate old codes, INSERT auth_tokens (password_reset, 1h)
    S->>E: sendPasswordResetEmail(email, code, name)
    E->>M: send email with code
  end
  C-->>W: 200 same message whether email exists or not
  U->>W: Enter code + new password
  W->>R: POST /api/v1/auth/reset-password {token, newPassword}
  R->>C: resetPassword(req, res)
  C->>S: resetPassword(token, newPassword)
  S->>T: resetPasswordWithToken(token, bcrypt hash)
  T->>DB: SELECT auth_tokens by hash
  alt wrong / used / expired code
    T-->>C: ApiError 400
    C-->>W: 400 Code is wrong, used or expired
  else valid
    T->>DB: BEGIN, consume code, UPDATE passwordHash, revoke all refresh tokens, COMMIT
    C-->>W: 200 Password reset, go to login
  end

  Note over U,M: 4. Change password (logged in)
  U->>W: Enter current + new password
  W->>R: PUT /api/v1/auth/change-password (Bearer token)
  R->>A: auth(req)
  alt token missing / invalid
    A-->>W: 401 Unauthorized
  else authenticated
    A->>C: changePassword(req, res) after validate
    C->>S: changePassword(userId, currentPassword, newPassword)
    S->>DB: SELECT passwordHash
    alt current password wrong / new same as current
      S-->>C: ApiError 400
      C-->>W: 400 error message
    else valid
      S->>DB: UPDATE users SET passwordHash (bcrypt 10)
      C-->>W: 200 Password changed
    end
  end
