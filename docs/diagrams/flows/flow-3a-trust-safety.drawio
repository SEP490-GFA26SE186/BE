        <mxCell id="d4" value="Active strikes &amp;gt;= 3?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="466" y="777" width="168" height="36" as="geometry" /></mxCell>
        <mxCell id="a9" value="Seller suspended,&lt;br&gt;all listings hidden" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="358" y="847" width="153" height="50" as="geometry" /></mxCell>
        <mxCell id="d5" value="Appeal the strike?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Arial;" vertex="1" parent="lane_SE"><mxGeometry x="82" y="931" width="155" height="36" as="geometry" /></mxCell>
        <mxCell id="a10" value="Strike expires after 90 days" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="444" y="1001" width="212" height="35" as="geometry" /></mxCell>
        <mxCell id="x3" value="" style="ellipse;html=1;shape=endState;aspect=fixed;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="lane_S"><mxGeometry x="534" y="1070" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="a11" value="Appeal once with a reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_SE"><mxGeometry x="64" y="1001" width="193" height="35" as="geometry" /></mxCell>
