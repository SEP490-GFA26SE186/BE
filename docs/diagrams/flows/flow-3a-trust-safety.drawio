      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Flow 3a: Trust &amp;amp; Safety - Report, Takedown, Strike, Appeal&lt;br&gt;(Buyer and Seller are Parent accounts)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="2360" height="40" as="geometry" /></mxCell>
        <mxCell id="lane_B" value="Buyer" style="swimlane;html=1;startSize=36;horizontal=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=16;swimlaneFillColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="320" height="1445" as="geometry" /></mxCell>
        <mxCell id="lane_S" value="System" style="swimlane;html=1;startSize=36;horizontal=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=16;swimlaneFillColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="340" y="10" width="700" height="1445" as="geometry" /></mxCell>
        <mxCell id="lane_SP" value="Specialist" style="swimlane;html=1;startSize=36;horizontal=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=16;swimlaneFillColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1040" y="10" width="600" height="1445" as="geometry" /></mxCell>
        <mxCell id="lane_SE" value="Seller" style="swimlane;html=1;startSize=36;horizontal=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=16;swimlaneFillColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1640" y="10" width="320" height="1445" as="geometry" /></mxCell>
        <mxCell id="lane_AD" value="Admin" style="swimlane;html=1;startSize=36;horizontal=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=16;swimlaneFillColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1960" y="10" width="420" height="1445" as="geometry" /></mxCell>
        <mxCell id="st" value="" style="ellipse;html=1;aspect=fixed;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="lane_B"><mxGeometry x="145" y="40" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="sp" value="" style="html=1;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="lane_B"><mxGeometry x="60" y="104" width="200" height="8" as="geometry" /></mxCell>
        <mxCell id="a1" value="Report a published listing&lt;br&gt;(category, optional page)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_B"><mxGeometry x="60" y="146" width="199" height="50" as="geometry" /></mxCell>
        <mxCell id="a2" value="Weekly cron: random audit&lt;br&gt;(skip listings approved in last 30 days)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="393" y="146" width="292" height="50" as="geometry" /></mxCell>
        <mxCell id="d1" value="&amp;gt;= 3 distinct reporters&lt;br&gt;in 24 h?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="131" y="230" width="186" height="50" as="geometry" /></mxCell>
        <mxCell id="a3" value="Auto-suspend listing,&lt;br&gt;open follow-up review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="57" y="314" width="166" height="50" as="geometry" /></mxCell>
        <mxCell id="d2" value="Report looks valid?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Arial;" vertex="1" parent="lane_SP"><mxGeometry x="114" y="321" width="161" height="36" as="geometry" /></mxCell>
        <mxCell id="a4" value="Dismiss the report" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_SP"><mxGeometry x="38" y="406" width="146" height="35" as="geometry" /></mxCell>
        <mxCell id="a5" value="Suspend listing manually (reason),&lt;br&gt;open follow-up review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_SP"><mxGeometry x="237" y="398" width="252" height="50" as="geometry" /></mxCell>
        <mxCell id="x1" value="" style="ellipse;html=1;shape=endState;aspect=fixed;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="lane_SP"><mxGeometry x="96" y="482" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="a6" value="Claim the review, view all pages" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_SP"><mxGeometry x="180" y="546" width="239" height="35" as="geometry" /></mxCell>
        <mxCell id="d3" value="Violation?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Arial;" vertex="1" parent="lane_SP"><mxGeometry x="240" y="615" width="120" height="36" as="geometry" /></mxCell>
        <mxCell id="a7" value="Keep: listing stays / returns to published&lt;br&gt;(audit never suspends it), open reports dismissed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="48" y="689" width="351" height="50" as="geometry" /></mxCell>
        <mxCell id="a8" value="Take down: listing archived,&lt;br&gt;reports resolved, issue strike (90 days)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="404" y="689" width="292" height="50" as="geometry" /></mxCell>
        <mxCell id="n1" value="Strikes also come from a rejected submission&lt;br&gt;with &amp;quot;issue strike&amp;quot; (Flow 2) or are issued&lt;br&gt;manually by a Specialist; same rules below." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#555555;fontSize=11;fontFamily=Arial;" vertex="1" parent="lane_SP"><mxGeometry x="233" y="685" width="302" height="58" as="geometry" /></mxCell>
