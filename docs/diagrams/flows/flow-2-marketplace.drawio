        <mxCell id="a3" value="Submit a reviewed private story:&lt;br&gt;price 0 or 5,000-500,000 VND,&lt;br&gt;generic name for each character" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_SE"><mxGeometry x="204" y="391" width="239" height="65" as="geometry" /></mxCell>
