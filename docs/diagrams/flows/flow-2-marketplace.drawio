        <mxCell id="a4" value="Create de-personalized copy (no family story),&lt;br&gt;copy ready scene images and cover,&lt;br&gt;regenerate narration with generic names,&lt;br&gt;listing = submitted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="264" y="560" width="331" height="80" as="geometry" /></mxCell>
        <mxCell id="a5" value="Claim review (30 min, narration ready),&lt;br&gt;view 100% of pages,&lt;br&gt;check pedagogy checklist on the web" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_SP"><mxGeometry x="48" y="674" width="285" height="65" as="geometry" /></mxCell>
        <mxCell id="d3" value="Decision?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Arial;" vertex="1" parent="lane_SP"><mxGeometry x="130" y="773" width="120" height="36" as="geometry" /></mxCell>
        <mxCell id="a6" value="listing = changes_requested / rejected&lt;br&gt;(optional strike on reject, Flow 3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="60" y="861" width="278" height="50" as="geometry" /></mxCell>
        <mxCell id="a7" value="listing = published" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="354" y="868" width="153" height="35" as="geometry" /></mxCell>
        <mxCell id="n1" value="Later the Seller may submit a new version:&lt;br&gt;same review; the old version stays on sale.&lt;br&gt;On approval, entitlements, bookshelves, reviews&lt;br&gt;and counters move to the new version, the old one&lt;br&gt;is archived; narration of unchanged segments is reused." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#555555;fontSize=11;fontFamily=Arial;" vertex="1" parent="lane_S"><mxGeometry x="542" y="843" width="300" height="86" as="geometry" /></mxCell>
