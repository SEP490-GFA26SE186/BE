        <mxCell id="a1" value="Apply as seller&lt;br&gt;(Family plan with can_sell)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane_SE"><mxGeometry x="157" y="104" width="206" height="50" as="geometry" /></mxCell>
        <mxCell id="d1" value="Approve seller profile?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Arial;" vertex="1" parent="lane_SP"><mxGeometry x="97" y="188" width="186" height="36" as="geometry" /></mxCell>
