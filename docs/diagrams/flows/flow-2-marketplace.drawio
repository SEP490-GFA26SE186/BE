        <mxCell id="title" value="Flow 2: Marketplace - Publish, Buy &amp;amp; Payout&lt;br&gt;(Seller and Buyer are Parent accounts)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="3000" height="40" as="geometry" /></mxCell>
