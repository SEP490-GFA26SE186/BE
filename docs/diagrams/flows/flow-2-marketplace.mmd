---
title: "Flow 2: Marketplace - Publish, Buy & Payout"
---
%%{init: {"flowchart": {"curve": "linear", "nodeSpacing": 22, "rankSpacing": 50}, "themeVariables": {"fontFamily": "Arial", "fontSize": "14px", "lineColor": "#555555"}}}%%
flowchart LR
  subgraph SEL["SELLER (Parent)"]
    EA(("Seller")):::actor
    E0["Apply as seller<br/>(plan allows selling)"]
    E1["Submit a reviewed private story:<br/>price 0 or 5,000-500,000 VND, aliases"]
    E2["Listing live<br/>on Marketplace"]
    E5["Optional: submit new version<br/>(old version stays on sale)"]
    E3["Request withdrawal<br/>(bank set > 24 h, >= 50,000 VND)"]
    E4["Payout received"]
  end
  subgraph SPEC["SPECIALIST"]
    MA(("Specialist")):::actor
    M0{"Approve seller?"}
    M1["Claim review (narration ready),<br/>view 100% pages,<br/>check pedagogy checklist on web"]
    M2{"Decision?"}
  end
  subgraph SYS["SYSTEM (Backend API + Cron)"]
    B1{"Real names / family<br/>details left?"}
    B2["De-personalized copy: drop family story,<br/>copy ready scenes + cover, regenerate<br/>narration, listing = submitted"]
    B3["Order pending,<br/>snapshot price + seller share"]
    B4{"Payment verified?"}
    B5["Grant entitlement,<br/>80% seller earning (pending),<br/>20% platform"]
    B8["Grant entitlement<br/>(free claim, no earning)"]
    B6["Cron: release earning<br/>after hold days (no pending refund)"]
    B7["Hold withdrawal amount<br/>(available → locked)"]
  end
  subgraph BUY["BUYER (Parent)"]
    UA(("Buyer")):::actor
    U0["Browse: competency,<br/>age, price + sort"]
    U1["Buy one story"]
    U2["Add to child's bookshelf"]
    U3["Rate story<br/>(after child finished)"]
  end
  subgraph PAY["payOS"]
    Y1["VietQR payment<br/>+ signed webhook"]
  end
  subgraph ADM["ADMIN"]
    AA(("Admin")):::actor
    A1{"Pay withdrawal?"}
    A2["Transfer by bank manually,<br/>mark paid + transaction ref"]
  end

  EA --> E0 --> M0
  M0 -- "Yes" --> E1
  M0 -- "No: re-apply" --> E0
  E1 --> B1
  B1 -- "Yes: 422, fix" --> E1
  B1 -- "No" --> B2 --> M1
  MA --> M1 --> M2
  M2 -- "Changes requested /<br/>rejected: fix and resubmit" --> E1
  M2 -- "Approved" --> E2
  E2 -.-> E5 -.-> M1

  E2 --> U0
  UA --> U0 --> U1 --> B3
  B3 -- "Price 0: paid now" --> B8 --> U2
  B3 -- "Price > 0" --> Y1 --> B4
  B4 -- "No: expired / failed" --> U1
  B4 -- "Yes" --> B5 --> U2 --> U3
  U2 -.-> F4(["Flow 4: Learning"]):::ext

  B5 --> B6 --> E3 --> B7 --> A1
  AA --> A1
  A1 -- "Yes" --> A2 --> E4
  A1 -- "No (reason): amount released" --> E3

  M2 -. "rejected: optional strike" .-> F3(["Flow 3: Trust & Safety"]):::ext
  E2 -. "reports, refunds" .-> F3

  classDef default fill:#EEEEEE,stroke:#999999,color:#111111
  classDef actor fill:#FFE0A3,stroke:#333333,stroke-width:2px,color:#111111
  classDef ext fill:#FFFFFF,stroke:#555555,stroke-dasharray:5 4,color:#111111
