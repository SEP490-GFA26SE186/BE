@startuml flow-4-learning
title Flow 4: Learning Through Stories
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #000000
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #000000
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #000000
skinparam SwimlaneBorderColor #000000
skinparam SwimlaneTitleFontStyle bold

|Parent|
|Child|
|System|

|Parent|
start
if (Kid Exit PIN set?) then (no)
  :Set PIN (4-6 digits);
else (yes)
endif
:Choose a child, enter Kid Mode;
|System|
:Issue kid_session token\n(24 h, closes the previous one);
|Child|
repeat
  :Open a story from the bookshelf;
  |System|
  if (Ready for child?\n(reviewed, all clips ready if narration on,\nlisting not suspended / taken down)) then (no)
    :422 Story not ready / temporarily taken down;
  else (yes)
    :Resume or create play session\n(is_first_play on first time);
    repeat
      :Send page: narration + illustration\n(no correct answers sent);
      |Child|
      :Listen and look at the page;
      |System|
      if (Checkpoint after this page?) then (yes)
        |Child|
        :Choose emotion / option\n(or skip, except reflection);
        |System|
        :First choice: snapshot score, sub-skill,\ntemplate version (no score if skipped / not scored);
        switch (Checkpoint type?)
        case (emotion / perspective)
          if (First choice wrong (not skipped)?) then (yes)
            :Give hint, ask again\n(second try not scored);
            |Child|
            :Choose again;
            |System|
            if (Still wrong?) then (yes)
              :Tell the correct answer;
            else (no)
            endif
          else (no)
          endif
        case (problem_solving)
          :Play feedback of the chosen option\n(no right / wrong);
        case (reflection)
          :Accept the answer\n(no right / wrong, not scored);
        endswitch
      else (no)
      endif
    repeat while (More pages?) is (yes) not (no)
    :Complete play session;
  endif
  |Child|
repeat while (Read another story?) is (yes) not (no)
|Parent|
repeat
  :Enter Kid Exit PIN;
  |System|
repeat while (Correct PIN?) is (no: attempts left,\n5 wrong = locked 15 min) not (yes)
:Close kid session, return parent tokens;
|Parent|
:Open EQ report of the child;
|System|
:Level per sub-skill from first-play scored answers\n(last 5, min 3, thresholds 0.5 / 0.8),\ncompetency = lowest level, suggested story templates;
|Parent|
:Talk with the child using suggested prompts,\npick the next story template;
stop
@enduml
