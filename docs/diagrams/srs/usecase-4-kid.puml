@startuml
!pragma layout smetana
left to right direction
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecaseBackgroundColor #EEF3FB
skinparam usecaseBorderColor #4A6FA5
actor "Parent" as Parent
actor "Child" as Child
rectangle "StoryWeaver AI – Kid Mode" {
  usecase "UC-18\nEnter Kid Mode" as UC18
  usecase "UC-19\nRead story" as UC19
  usecase "UC-20\nAnswer checkpoint" as UC20
  usecase "UC-21\nExit Kid Mode" as UC21
}
Parent --> UC18
Child --> UC19
Child --> UC20
Child --> UC21
Parent --> UC21
@enduml
