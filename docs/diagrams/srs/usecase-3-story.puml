@startuml
!pragma layout smetana
left to right direction
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecaseBackgroundColor #EEF3FB
skinparam usecaseBorderColor #4A6FA5
actor "Parent" as Parent
rectangle "StoryWeaver AI – Story creation, bookshelf and EQ report" {
  usecase "UC-09\nAnalyse family story" as UC09
  usecase "UC-10\nCreate story" as UC10
  usecase "UC-11\nWrite story with AI" as UC11
  usecase "UC-12\nEdit story" as UC12
  usecase "UC-13\nGenerate AI illustrations" as UC13
  usecase "UC-14\nReview story" as UC14
  usecase "UC-15\nRetry narration" as UC15
  usecase "UC-16\nManage bookshelf" as UC16
  usecase "UC-17\nView EQ report" as UC17
}
Parent --> UC09
Parent --> UC10
Parent --> UC11
Parent --> UC12
Parent --> UC13
Parent --> UC14
Parent --> UC15
Parent --> UC16
Parent --> UC17
actor "AI Service" as AIS
UC09 --> AIS
UC11 --> AIS
UC13 --> AIS
UC14 --> AIS
@enduml
