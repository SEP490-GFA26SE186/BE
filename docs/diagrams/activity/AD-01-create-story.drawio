" value="Child profile and&lt;br&gt;characters exist?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;spacing=0;" vertex="1" parent="AD-01-lane-P"><mxGeometry x="307.5" y="153.0" width="185" height="64" as="geometry"/></mxCell><mxCell id="AD-01-a_create" value="Create child profile and family characters" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;spacing=6;" vertex="1" parent="AD-01-lane-P"><mxGeometry x="65.0" y="250.0" width="200" height="42" as="geometry"/></mxCell><mxCell id="AD-01-a_choose" value="Choose an entry" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;spacing=6;" vertex="1" parent="AD-01-lane-P"><mxGeometry x="300.0" y="337.0" width="200" height="40" as="geometry"/></mxCell><mxCell id="AD-01-d_entry" value="Entry?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;spacing=0;" vertex="1" parent="AD-01-lane-P"><mxGeometry x="368.0" y="420.0" width="64" height="46" as="geometry"/></mxCell><mxCell id="AD-01-a_hand" value="Choose &quot;write it myself&quot;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;spacing=6;" vertex="1" parent="AD-01-lane-P"><mxGeometry x="65.0" y="509.0" width="200" height="40" as="geometry"/></mxCell><mxCell id="AD-01-a_model" value="Choose a model story (topic), characters and length" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;spacing=6;" vertex="1" parent="AD-01-lane-P"><mxGeometry x="300.0" y="508.0" width="200" height="42" as="geometry"/></mxCell><mxCell id="AD-01-a_family" value="Tell the family story, choose characters and length" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;stroke