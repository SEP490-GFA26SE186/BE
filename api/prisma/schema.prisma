// =============================================================================
// StoryWeaver AI – Prisma Schema (PostgreSQL)
// SEP490 / SE186 – revision 8 – 49 models, 32 enums
//
// Nguon su that: ai/StoryWeaver-docs/StoryWeaver-docs/db/schema_rev8.dbml
// Sai khac co y so voi DBML:
//   - users.username: DBML rev8 thieu cot nay, nhung auth dung de login -> giu lai.
//   - entitlements.order_item_id: DBML ghi [not null] + [delete: set null] (mau thuan).
//     Giu NOT NULL, doi sang Restrict. Xem @note tren model Entitlement.
//
// Nhung rang buoc Prisma KHONG dien ta duoc (CHECK, partial unique, generated
// column) duoc viet tay o cuoi file migration. Moi cai deu co /// @note o day.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // plpgsql co san trong moi Postgres; khai bao o day de `migrate diff` khong
  // bao drift gia. citext dung cho users.email (so sanh khong phan biet hoa/thuong).
  extensions = [citext, plpgsql]
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  admin
  moderator
  parent

  @@map("user_role")
}

enum AuthTokenType {
  refresh
  email_verify
  password_reset
  kid_session

  @@map("auth_token_type")
}

enum GenerationStatus {
  none
  queued
  generating
  ready
  failed

  @@map("generation_status")
}

enum StoryLength {
  short
  medium
  long
  custom

  @@map("story_length")
}

enum CheckpointType {
  emotion_self
  emotion_other
  perspective
  problem_solving
  reflection

  @@map("checkpoint_type")
}

enum Emotion {
  happy
  sad
  angry
  scared
  neutral

  @@map("emotion")
}

enum OptionRole {
  constructive
  avoidant
  impulsive

  @@map("option_role")
}

enum StoryKind {
  private
  published

  @@map("story_kind")
}

enum StoryStatus {
  draft
  generating
  ready

  @@map("story_status")
}

enum ContentOrigin {
  human
  ai
  ai_edited

  @@map("content_origin")
}

enum PlayStatus {
  in_progress
  completed
  abandoned

  @@map("play_status")
}

enum AiRequestType {
  story_text
  character_portrait
  scene_image
  narration

  @@map("ai_request_type")
}

enum AiRequestStatus {
  queued
  processing
  succeeded
  failed
  blocked

  @@map("ai_request_status")
}

enum SellerStatus {
  pending
  approved
  rejected
  suspended

  @@map("seller_status")
}

enum ListingStatus {
  submitted
  in_review
  changes_requested
  rejected
  published
  suspended
  archived

  @@map("listing_status")
}

enum ReviewTag {
  child_liked
  age_appropriate
  clear_lesson
  beautiful_art
  good_narration

  @@map("review_tag")
}

enum SubscriptionStatus {
  active
  expired
  cancelled

  @@map("subscription_status")
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
  expired

  @@map("order_status")
}

enum OrderItemType {
  plan
  listing

  @@map("order_item_type")
}

enum OrderItemStatus {
  active
  refunded

  @@map("order_item_status")
}

enum VoucherDiscountType {
  percent
  fixed

  @@map("voucher_discount_type")
}

enum RequestStatus {
  pending
  approved
  rejected
  cancelled

  @@map("request_status")
}

enum WithdrawalStatus {
  requested
  paid
  rejected
  cancelled

  @@map("withdrawal_status")
}

enum WalletType {
  credit
  earning

  @@map("wallet_type")
}

enum LedgerEntryType {
  credit_grant
  credit_expire
  credit_hold
  credit_release
  credit_consume
  earning_pending
  earning_release
  earning_reversal
  withdrawal_hold
  withdrawal_paid
  withdrawal_release

  @@map("ledger_entry_type")
}

enum ModerationReviewType {
  submission
  random_audit
  report_followup

  @@map("moderation_review_type")
}

enum ModerationDecision {
  approved
  changes_requested
  rejected
  taken_down

  @@map("moderation_decision")
}

enum ReportCategory {
  scary
  violent
  inappropriate_lesson
  personal_info
  technical_error
  other

  @@map("report_category")
}

enum ReportStatus {
  open
  resolved
  dismissed

  @@map("report_status")
}

enum StrikeSource {
  report
  rejection
  takedown

  @@map("strike_source")
}

enum KeywordSeverity {
  block
  warn

  @@map("keyword_severity")
}

enum CaselCompetency {
  self_awareness
  self_management
  social_awareness
  relationship_skills
  responsible_decision_making

  @@map("casel_competency")
}

// =============================================================================
// 1. ACCOUNTS
// =============================================================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  role            UserRole  @default(parent)
  username        String    @unique @db.VarChar(50)
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String?   @map("full_name") @db.VarChar(150)
  phone           String?   @db.VarChar(20)
  kidExitPinHash  String?   @map("kid_exit_pin_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz()
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz()
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()

  // -- back-references --
  authTokens                AuthToken[]
  childProfiles             ChildProfile[]
  characters                Character[]
  topicsCreated             Topic[]             @relation("TopicCreator")
  backgroundsCreated        Background[]        @relation("BackgroundCreator")
  blockedKeywordsCreated    BlockedKeyword[]    @relation("KeywordCreator")
  stories                   Story[]
  promptTemplatesCreated    PromptTemplate[]    @relation("PromptTemplateCreator")
  aiRequests                AiRequest[]
  sellerProfile             SellerProfile?      @relation("SellerUser")
  sellerProfilesReviewed    SellerProfile[]     @relation("SellerReviewer")
  cartItems                 CartItem[]
  entitlements              Entitlement[]
  productReviews            ProductReview[]     @relation("ReviewAuthor")
  hiddenReviews             ProductReview[]     @relation("ReviewHiddenBy")
  subscriptions             Subscription[]
  vouchersCreated           Voucher[]           @relation("VoucherCreator")
  orders                    Order[]
  voucherUsages             VoucherUsage[]
  refundRequestsMade        RefundRequest[]     @relation("RefundRequester")
  refundRequestsHandled     RefundRequest[]     @relation("RefundHandler")
  wallet                    Wallet?
  walletLedgerEntries       WalletLedger[]
  withdrawalRequestsHandled WithdrawalRequest[] @relation("WithdrawalHandler")
  platformSettingsUpdated   PlatformSetting[]   @relation("SettingUpdater")
  moderationReviews         ModerationReview[]  @relation("ModReviewModerator")
  contentReportsFiled       ContentReport[]     @relation("ReportReporter")
  contentReportsHandled     ContentReport[]     @relation("ReportHandler")
  creatorStrikesIssued      CreatorStrike[]     @relation("StrikeIssuer")
  strikeAppealsDecided      StrikeAppeal[]      @relation("AppealDecider")
  auditLogs                 AdminAuditLog[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

/// @note CHECK: (type = 'kid_session') = (child_id IS NOT NULL)
/// @note CHECK: replaced_by_id IS NULL OR type = 'refresh'
/// @note Partial unique: UNIQUE (child_id) WHERE type = 'kid_session' AND consumed_at IS NULL
model AuthToken {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  type         AuthTokenType
  tokenHash    String        @unique @map("token_hash") @db.VarChar(255)
  replacedById String?       @map("replaced_by_id") @db.Uuid
  childId      String?       @map("child_id") @db.Uuid
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz()
  consumedAt   DateTime?     @map("consumed_at") @db.Timestamptz()
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthToken?    @relation("TokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  child      ChildProfile? @relation(fields: [childId], references: [id], onDelete: Cascade)

  previousTokens AuthToken[] @relation("TokenReplacement")

  @@index([userId, type])
  @@index([expiresAt])
  @@index([childId])
  @@map("auth_tokens")
}

model ChildProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  parentId               String    @map("parent_id") @db.Uuid
  name                   String    @db.VarChar(100)
  birthDate              DateTime? @map("birth_date") @db.Date
  dailyScreenTimeMinutes Int       @default(30) @map("daily_screen_time_minutes")
  preferredVoice         String?   @map("preferred_voice") @db.VarChar(50)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz()

  parent User @relation(fields: [parentId], references: [id], onDelete: Restrict)

  // -- back-references --
  authTokens        AuthToken[]
  character         Character?
  usageSessions     ChildUsageSession[]
  bookshelfItems    BookshelfItem[]
  playSessions      PlaySession[]
  eqCompetencyStats EqCompetencyStat[]

  @@index([parentId])
  @@map("child_profiles")
}

/// @note child_id: moi con toi da 1 nhan vat dai dien (unique)
/// @note portrait_image_key: chan dung AI phu huynh da chon, dung lam anh tham chieu
model Character {
  id               String           @id @default(uuid()) @db.Uuid
  parentId         String           @map("parent_id") @db.Uuid
  childId          String?          @unique @map("child_id") @db.Uuid
  name             String           @db.VarChar(100)
  appearance       String
  portraitImageKey String?          @map("portrait_image_key") @db.VarChar(300)
  genPrompt        String?          @map("gen_prompt")
  genSeed          BigInt?          @map("gen_seed")
  portraitStatus   GenerationStatus @default(none) @map("portrait_status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz()

  parent User          @relation(fields: [parentId], references: [id], onDelete: Restrict)
  child  ChildProfile? @relation(fields: [childId], references: [id], onDelete: SetNull)

  // -- back-references --
  storyCharacters StoryCharacter[]
  aiRequests      AiRequest[]

  @@index([parentId])
  @@map("characters")
}

/// @note duration_seconds: GENERATED ALWAYS AS (extract(epoch from ended_at - started_at)::int) STORED
/// @note usage_date: GENERATED ALWAYS AS ((started_at AT TIME ZONE 'Asia/Ho_Chi_Minh')::date) STORED
/// @note Ca hai cot generated duoc viet tay trong migration; Prisma khong sinh duoc.
model ChildUsageSession {
  id              String    @id @default(uuid()) @db.Uuid
  childId         String    @map("child_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  endedAt         DateTime? @map("ended_at") @db.Timestamptz()
  durationSeconds Int?      @default(dbgenerated()) @map("duration_seconds")
  usageDate       DateTime  @default(dbgenerated()) @map("usage_date") @db.Date

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, usageDate])
  @@map("child_usage_sessions")
}

// =============================================================================
// 2. CONTENT LIBRARY (Moderator quan ly)
// =============================================================================

model EqSkill {
  id           String          @id @default(uuid()) @db.Uuid
  caselCode    CaselCompetency @unique @map("casel_code")
  nameVi       String          @map("name_vi") @db.VarChar(100)
  nameEn       String          @map("name_en") @db.VarChar(100)
  description  String
  displayOrder Int             @default(0) @map("display_order")

  // -- back-references --
  topics            Topic[]
  checkpointAnswers CheckpointAnswer[]
  eqCompetencyStats EqCompetencyStat[]

  @@map("eq_skills")
}

/// @note Danh sach bai hoc do Moderator quan ly
/// @note CHECK: age_min <= age_max
model Topic {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(200)
  skillId      String   @map("skill_id") @db.Uuid
  guidance     String
  ageMin       Int      @default(5) @map("age_min")
  ageMax       Int      @default(8) @map("age_max")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  skill   EqSkill @relation(fields: [skillId], references: [id], onDelete: Restrict)
  creator User    @relation("TopicCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  // -- back-references --
  stories Story[]

  @@index([isActive, skillId])
  @@map("topics")
}

/// @note Thu vien nen mac dinh, dung khi stories.use_ai_image = false
model Background {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  imageKey  String   @map("image_key") @db.VarChar(300)
  tags      String?  @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  creator User @relation("BackgroundCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  // -- back-references --
  storyScenes StoryScene[]

  @@map("backgrounds")
}

model UiAudioAsset {
  id          String @id @default(uuid()) @db.Uuid
  key         String @db.VarChar(80)
  lang        String @default("vi") @db.VarChar(10)
  textContent String @map("text_content")
  audioKey    String @map("audio_key") @db.VarChar(300)

  @@unique([key, lang])
  @@map("ui_audio_assets")
}

model BlockedKeyword {
  id        String          @id @default(uuid()) @db.Uuid
  keyword   String          @unique @db.VarChar(100)
  severity  KeywordSeverity @default(block)
  isActive  Boolean         @default(true) @map("is_active")
  createdBy String          @map("created_by") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  creator User @relation("KeywordCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("blocked_keywords")
}

/// @note description: 7 nguyen tac su pham
model ChecklistItem {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique @db.VarChar(40)
  description  String
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  // -- back-references --
  reviewResults ReviewChecklistResult[]

  @@map("checklist_items")
}

// =============================================================================
// 3. STORIES
// =============================================================================

/// @note private  : truyen phu huynh tao cho con minh, sua tu do
/// @note published: ban sao da go ca nhan hoa de ban; dong bang sau khi duyet
/// @note CHECK: kind <> 'published' OR source_story_id IS NOT NULL
/// @note Chi dua vao gia sach khi reviewed_at IS NOT NULL (validator tang service)
/// @note Truyen custom (validator khi luu): 4-20 trang, 0-6 diem dung co cham,
///       khong dat sau trang 1, reflection chi o cuoi
model Story {
  id            String      @id @default(uuid()) @db.Uuid
  ownerId       String      @map("owner_id") @db.Uuid
  kind          StoryKind   @default(private)
  sourceStoryId String?     @map("source_story_id") @db.Uuid
  topicId       String      @map("topic_id") @db.Uuid
  length        StoryLength @default(medium)
  title         String      @db.VarChar(200)
  situation     String?
  useAiImage    Boolean     @default(false) @map("use_ai_image")
  useTts        Boolean     @default(true) @map("use_tts")
  status        StoryStatus @default(draft)
  reviewedAt    DateTime?   @map("reviewed_at") @db.Timestamptz()
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz()

  owner       User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sourceStory Story? @relation("StorySource", fields: [sourceStoryId], references: [id], onDelete: SetNull)
  topic       Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict)

  // -- back-references --
  copies          Story[]           @relation("StorySource")
  storyCharacters StoryCharacter[]
  scenes          StoryScene[]
  pages           StoryPage[]
  checkpoints     StoryCheckpoint[]
  bookshelfItems  BookshelfItem[]
  playSessions    PlaySession[]
  aiRequests      AiRequest[]
  listing         Listing?

  @@index([ownerId, kind])
  @@index([topicId])
  @@map("stories")
}

/// @note token: {NV1}, {NV2}...
/// @note CHECK: (character_id IS NOT NULL) <> (alias_name IS NOT NULL)
/// @note Partial unique: UNIQUE (story_id) WHERE is_main
model StoryCharacter {
  storyId     String  @map("story_id") @db.Uuid
  token       String  @db.VarChar(10)
  characterId String? @map("character_id") @db.Uuid
  aliasName   String? @map("alias_name") @db.VarChar(100)
  isMain      Boolean @default(false) @map("is_main")

  story     Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@id([storyId, token])
  @@index([characterId])
  @@map("story_characters")
}

/// @note Toi da 4 canh moi truyen; cac trang cung canh dung chung mot tranh
/// @note description: mo ta canh tieng Anh, khong ten rieng
model StoryScene {
  id           String           @id @default(uuid()) @db.Uuid
  storyId      String           @map("story_id") @db.Uuid
  sceneOrder   Int              @map("scene_order")
  description  String
  imageKey     String?          @map("image_key") @db.VarChar(300)
  backgroundId String?          @map("background_id") @db.Uuid
  imageStatus  GenerationStatus @default(none) @map("image_status")

  story      Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  background Background? @relation(fields: [backgroundId], references: [id], onDelete: Restrict)

  // -- back-references --
  pages      StoryPage[]
  aiRequests AiRequest[]

  @@unique([storyId, sceneOrder])
  @@map("story_scenes")
}

/// @note content_text / ai_original_text: luu dang token {NVx}
model StoryPage {
  id             String           @id @default(uuid()) @db.Uuid
  storyId        String           @map("story_id") @db.Uuid
  pageOrder      Int              @map("page_order")
  sceneId        String           @map("scene_id") @db.Uuid
  contentText    String?          @map("content_text")
  aiOriginalText String?          @map("ai_original_text")
  origin         ContentOrigin    @default(human)
  audioKey       String?          @map("audio_key") @db.VarChar(300)
  audioStatus    GenerationStatus @default(none) @map("audio_status")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  story Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  scene StoryScene @relation(fields: [sceneId], references: [id], onDelete: Restrict)

  // -- back-references --
  checkpoint         StoryCheckpoint?
  playSessionsOnPage PlaySession[]
  aiRequests         AiRequest[]
  reviewPageViews    ReviewPageView[]
  contentReports     ContentReport[]

  @@unique([storyId, pageOrder])
  @@index([sceneId])
  @@map("story_pages")
}

/// @note short/medium/long: kieu va vi tri do he thong dat; custom: nguoi viet tu dat
/// @note after_page_id unique: moi trang toi da 1 diem dung ngay sau no
/// @note CHECK: (type IN ('emotion_self','emotion_other')) = (answer_emotion IS NOT NULL)
/// @note CHECK: (type IN ('emotion_other','perspective')) = (target_token IS NOT NULL)
model StoryCheckpoint {
  id               String         @id @default(uuid()) @db.Uuid
  storyId          String         @map("story_id") @db.Uuid
  afterPageId      String         @unique @map("after_page_id") @db.Uuid
  type             CheckpointType
  targetToken      String?        @map("target_token") @db.VarChar(10)
  question         String?
  answerEmotion    Emotion?       @map("answer_emotion")
  hint             String?
  origin           ContentOrigin  @default(human)
  questionAudioKey String?        @map("question_audio_key") @db.VarChar(300)
  hintAudioKey     String?        @map("hint_audio_key") @db.VarChar(300)

  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  afterPage StoryPage @relation(fields: [afterPageId], references: [id], onDelete: Cascade)

  // -- back-references --
  options    CheckpointOption[]
  answers    CheckpointAnswer[]
  aiRequests AiRequest[]

  @@index([storyId])
  @@map("story_checkpoints")
}

/// @note perspective    : dung 3 phuong an, dung 1 phuong an is_correct = true
/// @note problem_solving: dung 3 phuong an, du 3 role, moi role mot lan
/// @note Ca hai luat tren la validator tang service (CHECK khong lam duoc)
/// @note Thu tu hien thi xao ngau nhien o frontend, option_order chi de luu tru
model CheckpointOption {
  id               String      @id @default(uuid()) @db.Uuid
  checkpointId     String      @map("checkpoint_id") @db.Uuid
  optionOrder      Int         @map("option_order")
  text             String?
  role             OptionRole?
  isCorrect        Boolean?    @map("is_correct")
  feedback         String?
  textAudioKey     String?     @map("text_audio_key") @db.VarChar(300)
  feedbackAudioKey String?     @map("feedback_audio_key") @db.VarChar(300)

  checkpoint StoryCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  // -- back-references --
  firstAnswers CheckpointAnswer[] @relation("AnswerFirstOption")
  finalAnswers CheckpointAnswer[] @relation("AnswerFinalOption")

  @@unique([checkpointId, optionOrder])
  @@map("checkpoint_options")
}

model BookshelfItem {
  childId String   @map("child_id") @db.Uuid
  storyId String   @map("story_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz()

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  story Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([childId, storyId])
  @@map("bookshelf_items")
}

// =============================================================================
// 4. LEARNING
// =============================================================================

/// @note is_first_play: chi lan choi dau duoc tinh diem EQ
/// @note Partial unique: UNIQUE (child_id, story_id) WHERE is_first_play
model PlaySession {
  id             String     @id @default(uuid()) @db.Uuid
  childId        String     @map("child_id") @db.Uuid
  storyId        String     @map("story_id") @db.Uuid
  isFirstPlay    Boolean    @map("is_first_play")
  status         PlayStatus @default(in_progress)
  currentPageId  String?    @map("current_page_id") @db.Uuid
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz()
  lastActivityAt DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz()
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz()

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Restrict)
  story       Story        @relation(fields: [storyId], references: [id], onDelete: Restrict)
  currentPage StoryPage?   @relation(fields: [currentPageId], references: [id], onDelete: SetNull)

  // -- back-references --
  answers CheckpointAnswer[]

  @@index([childId, status])
  @@index([storyId, status])
  @@map("play_sessions")
}

/// @note skill_id / score tinh ngay luc tra loi va dong bang (SNAPSHOT):
///       emotion_self -> Tu nhan thuc; emotion_other, perspective -> Nhan thuc xa hoi;
///       problem_solving -> nang luc cua topic (constructive 1, avoidant 0.5, impulsive 0)
/// @note Doi topic hay doi cach cham ve sau khong lam thay doi lich su
/// @note CHECK: attempts BETWEEN 1 AND 2
model CheckpointAnswer {
  id              BigInt   @id @default(autoincrement())
  sessionId       String   @map("session_id") @db.Uuid
  checkpointId    String   @map("checkpoint_id") @db.Uuid
  firstEmotion    Emotion? @map("first_emotion")
  firstOptionId   String?  @map("first_option_id") @db.Uuid
  finalEmotion    Emotion? @map("final_emotion")
  finalOptionId   String?  @map("final_option_id") @db.Uuid
  attempts        Int      @default(1)
  skipped         Boolean  @default(false)
  timeToFirstMs   Int?     @map("time_to_first_ms")
  questionReplays Int      @default(0) @map("question_replays")
  skillId         String?  @map("skill_id") @db.Uuid
  score           Decimal? @db.Decimal(3, 2)
  answeredAt      DateTime @default(now()) @map("answered_at") @db.Timestamptz()

  session     PlaySession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  checkpoint  StoryCheckpoint   @relation(fields: [checkpointId], references: [id], onDelete: Restrict)
  firstOption CheckpointOption? @relation("AnswerFirstOption", fields: [firstOptionId], references: [id], onDelete: Restrict)
  finalOption CheckpointOption? @relation("AnswerFinalOption", fields: [finalOptionId], references: [id], onDelete: Restrict)
  skill       EqSkill?          @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([sessionId, checkpointId])
  @@index([skillId, answeredAt])
  @@map("checkpoint_answers")
}

/// @note CACHE toan bo lich su, chi tinh tu checkpoint_answers cua lan choi dau, khong skipped
/// @note Diem = score_sum / items * 100; hien "chua du du lieu" khi items < 5
/// @note Bieu do theo thang: truy van truc tiep checkpoint_answers theo answered_at
/// @note Cron doi soat hang dem tinh lai tu du lieu goc
model EqCompetencyStat {
  childId   String   @map("child_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  items     Int      @default(0)
  scoreSum  Decimal  @default(0) @map("score_sum") @db.Decimal(8, 2)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  skill EqSkill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([childId, skillId])
  @@map("eq_competency_stats")
}

// =============================================================================
// 5. AI
// =============================================================================

/// @note Partial unique: UNIQUE (request_type) WHERE is_active
model PromptTemplate {
  id           String        @id @default(uuid()) @db.Uuid
  requestType  AiRequestType @map("request_type")
  version      String        @db.VarChar(30)
  templateText String        @map("template_text")
  modelName    String        @map("model_name") @db.VarChar(100)
  isActive     Boolean       @default(false) @map("is_active")
  activatedAt  DateTime?     @map("activated_at") @db.Timestamptz()
  createdBy    String        @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  creator User @relation("PromptTemplateCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  // -- back-references --
  aiRequests AiRequest[]

  @@unique([requestType, version])
  @@map("prompt_templates")
}

/// @note credits_charged = don gia trong platform_settings (ai_cost.<type>) luc giu credit
/// @note That bai -> hoan credit (credit_release)
/// @note CHECK: attempts <= 3
/// @note locked_at: bang nay kiem luon hang doi tac vu nen
model AiRequest {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  requestType        AiRequestType   @map("request_type")
  storyId            String?         @map("story_id") @db.Uuid
  pageId             String?         @map("page_id") @db.Uuid
  checkpointId       String?         @map("checkpoint_id") @db.Uuid
  sceneId            String?         @map("scene_id") @db.Uuid
  characterId        String?         @map("character_id") @db.Uuid
  promptTemplateId   String?         @map("prompt_template_id") @db.Uuid
  provider           String          @default("mock") @db.VarChar(40)
  modelName          String?         @map("model_name") @db.VarChar(100)
  status             AiRequestStatus @default(queued)
  creditsCharged     Int             @default(0) @map("credits_charged")
  inputTokens        Int?            @map("input_tokens")
  outputTokens       Int?            @map("output_tokens")
  outputUnits        Int?            @map("output_units")
  providerCostMicros BigInt          @default(0) @map("provider_cost_micros")
  attempts           Int             @default(0)
  lockedAt           DateTime?       @map("locked_at") @db.Timestamptz()
  errorMessage       String?         @map("error_message")
  idempotencyKey     String          @unique @map("idempotency_key") @db.VarChar(120)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  finishedAt         DateTime?       @map("finished_at") @db.Timestamptz()

  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  story          Story?           @relation(fields: [storyId], references: [id], onDelete: SetNull)
  page           StoryPage?       @relation(fields: [pageId], references: [id], onDelete: SetNull)
  checkpoint     StoryCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  scene          StoryScene?      @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  character      Character?       @relation(fields: [characterId], references: [id], onDelete: SetNull)
  promptTemplate PromptTemplate?  @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([storyId])
  @@map("ai_requests")
}

// =============================================================================
// 6. MARKETPLACE
// =============================================================================

/// @note bank_account_number: ma hoa khi luu
/// @note bank_updated_at: chan rut tien 24 gio sau khi doi
model SellerProfile {
  userId            String       @id @map("user_id") @db.Uuid
  displayName       String       @map("display_name") @db.VarChar(100)
  bio               String?
  expertise         String?
  status            SellerStatus @default(pending)
  reviewedBy        String?      @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?    @map("reviewed_at") @db.Timestamptz()
  bankName          String?      @map("bank_name") @db.VarChar(100)
  bankAccountNumber String?      @map("bank_account_number") @db.VarChar(255)
  bankAccountHolder String?      @map("bank_account_holder") @db.VarChar(150)
  bankUpdatedAt     DateTime?    @map("bank_updated_at") @db.Timestamptz()
  totalSales        Int          @default(0) @map("total_sales")
  ratingAvg         Decimal?     @map("rating_avg") @db.Decimal(3, 2)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user     User  @relation("SellerUser", fields: [userId], references: [id], onDelete: Restrict)
  reviewer User? @relation("SellerReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  // -- back-references --
  listings           Listing[]
  withdrawalRequests WithdrawalRequest[]
  strikes            CreatorStrike[]

  @@map("seller_profiles")
}

model PriceTier {
  id       String  @id @default(uuid()) @db.Uuid
  label    String  @db.VarChar(50)
  priceVnd BigInt  @unique @map("price_vnd")
  isActive Boolean @default(true) @map("is_active")

  // -- back-references --
  listings Listing[]

  @@map("price_tiers")
}

/// @note published_story_id: stories.kind = 'published'
/// @note Bo dem (purchase_count, rating_*) cap nhat trong cung transaction + cron doi soat hang dem
model Listing {
  id                String        @id @default(uuid()) @db.Uuid
  sellerId          String        @map("seller_id") @db.Uuid
  publishedStoryId  String        @unique @map("published_story_id") @db.Uuid
  previousListingId String?       @map("previous_listing_id") @db.Uuid
  title             String        @db.VarChar(200)
  description       String?
  coverImageKey     String?       @map("cover_image_key") @db.VarChar(300)
  priceTierId       String        @map("price_tier_id") @db.Uuid
  status            ListingStatus @default(submitted)
  hasAiContent      Boolean       @default(false) @map("has_ai_content")
  purchaseCount     Int           @default(0) @map("purchase_count")
  freeClaimCount    Int           @default(0) @map("free_claim_count")
  ratingAvg         Decimal?      @map("rating_avg") @db.Decimal(3, 2)
  ratingCount       Int           @default(0) @map("rating_count")
  submittedAt       DateTime      @default(now()) @map("submitted_at") @db.Timestamptz()
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz()
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  seller          SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Restrict)
  publishedStory  Story         @relation(fields: [publishedStoryId], references: [id], onDelete: Restrict)
  previousListing Listing?      @relation("ListingVersion", fields: [previousListingId], references: [id], onDelete: SetNull)
  priceTier       PriceTier     @relation(fields: [priceTierId], references: [id], onDelete: Restrict)

  // -- back-references --
  nextListings      Listing[]          @relation("ListingVersion")
  cartItems         CartItem[]
  entitlements      Entitlement[]
  productReviews    ProductReview[]
  orderItems        OrderItem[]
  moderationReviews ModerationReview[]
  contentReports    ContentReport[]

  @@index([status, publishedAt])
  @@index([sellerId])
  @@map("listings")
}

model CartItem {
  parentId  String   @map("parent_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz()

  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([parentId, listingId])
  @@map("cart_items")
}

/// @note order_item_id: moi quyen deu den tu mot don; truyen mien phi = don 0d
/// @note Partial unique: UNIQUE (parent_id, listing_id) WHERE revoked_at IS NULL
/// @note DBML ghi [not null] + [delete: set null] (mau thuan). Giu NOT NULL -> Restrict.
model Entitlement {
  id          String    @id @default(uuid()) @db.Uuid
  parentId    String    @map("parent_id") @db.Uuid
  listingId   String    @map("listing_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz()
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz()

  parent    User      @relation(fields: [parentId], references: [id], onDelete: Restrict)
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([parentId])
  @@map("entitlements")
}

/// @note CHECK: rating BETWEEN 1 AND 5
/// @note hidden_at: NULL = dang hien; an thi khong tinh vao diem
/// @note Chi nguoi da mua va con da nghe het moi duoc danh gia (validator tang service)
model ProductReview {
  id              String    @id @default(uuid()) @db.Uuid
  listingId       String    @map("listing_id") @db.Uuid
  parentId        String    @map("parent_id") @db.Uuid
  rating          Int
  comment         String?
  hiddenAt        DateTime? @map("hidden_at") @db.Timestamptz()
  hiddenBy        String?   @map("hidden_by") @db.Uuid
  sellerReply     String?   @map("seller_reply")
  sellerRepliedAt DateTime? @map("seller_replied_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author       User    @relation("ReviewAuthor", fields: [parentId], references: [id], onDelete: Restrict)
  hiddenByUser User?   @relation("ReviewHiddenBy", fields: [hiddenBy], references: [id], onDelete: SetNull)

  // -- back-references --
  tags           ProductReviewTag[]
  contentReports ContentReport[]

  @@unique([listingId, parentId])
  @@index([listingId, hiddenAt])
  @@map("product_reviews")
}

model ProductReviewTag {
  reviewId String    @map("review_id") @db.Uuid
  tag      ReviewTag

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, tag])
  @@map("product_review_tags")
}

// =============================================================================
// 7. COMMERCE & WALLET
// =============================================================================

/// @note duration_months: 1 = goi thang, 12 = goi nam
/// @note credits_per_month: cap moi thang, ke ca goi nam
model Plan {
  id              String  @id @default(uuid()) @db.Uuid
  code            String  @unique @db.VarChar(40)
  name            String  @db.VarChar(100)
  durationMonths  Int     @map("duration_months")
  priceVnd        BigInt  @map("price_vnd")
  creditsPerMonth Int     @map("credits_per_month")
  maxChildren     Int     @map("max_children")
  maxCharacters   Int     @map("max_characters")
  canSell         Boolean @default(false) @map("can_sell")
  isActive        Boolean @default(true) @map("is_active")

  // -- back-references --
  subscriptions Subscription[]
  orderItems    OrderItem[]

  @@map("plans")
}

/// @note Tra truoc, gia han thu cong
/// @note Partial unique: UNIQUE (parent_id) WHERE status = 'active'
/// @note Cron hang ngay: toi next_credit_grant_at -> credit_expire phan con lai, credit_grant thang moi
/// @note Nang goi giua ky: ky moi bat dau ngay, cap du credit goi moi, credit con lai giu mot lan
/// @note Goi Mien phi cung la mot dong subscriptions
model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  parentId          String             @map("parent_id") @db.Uuid
  planId            String             @map("plan_id") @db.Uuid
  orderItemId       String?            @map("order_item_id") @db.Uuid
  periodStart       DateTime           @map("period_start") @db.Timestamptz()
  periodEnd         DateTime           @map("period_end") @db.Timestamptz()
  nextCreditGrantAt DateTime           @map("next_credit_grant_at") @db.Timestamptz()
  status            SubscriptionStatus @default(active)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  parent    User       @relation(fields: [parentId], references: [id], onDelete: Restrict)
  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([parentId, status])
  @@index([status, periodEnd])
  @@map("subscriptions")
}

/// @note Voucher do nen tang chiu: doanh thu nguoi ban tinh tren gia niem yet
model Voucher {
  id             String              @id @default(uuid()) @db.Uuid
  code           String              @unique @db.VarChar(40)
  discountType   VoucherDiscountType @map("discount_type")
  value          BigInt
  maxDiscountVnd BigInt?             @map("max_discount_vnd")
  minOrderVnd    BigInt              @default(0) @map("min_order_vnd")
  startsAt       DateTime            @map("starts_at") @db.Timestamptz()
  endsAt         DateTime            @map("ends_at") @db.Timestamptz()
  usageLimit     Int?                @map("usage_limit")
  perUserLimit   Int                 @default(1) @map("per_user_limit")
  usedCount      Int                 @default(0) @map("used_count")
  isActive       Boolean             @default(true) @map("is_active")
  createdBy      String              @map("created_by") @db.Uuid

  creator User @relation("VoucherCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  // -- back-references --
  orders Order[]
  usages VoucherUsage[]

  @@map("vouchers")
}

/// @note Webhook: UPDATE ... SET status = 'paid' WHERE id = ? AND status = 'pending'
/// @note CHECK: total_vnd = 0 OR payos_order_code IS NOT NULL
/// @note Don 0d: tao xong chuyen paid ngay, khong goi payOS
model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  buyerId            String      @map("buyer_id") @db.Uuid
  voucherId          String?     @map("voucher_id") @db.Uuid
  subtotalVnd        BigInt      @map("subtotal_vnd")
  discountVnd        BigInt      @default(0) @map("discount_vnd")
  totalVnd           BigInt      @map("total_vnd")
  status             OrderStatus @default(pending)
  payosOrderCode     BigInt?     @unique @map("payos_order_code")
  payosPaymentLinkId String?     @map("payos_payment_link_id") @db.VarChar(100)
  payosTransactionId String?     @unique @map("payos_transaction_id") @db.VarChar(100)
  paidAt             DateTime?   @map("paid_at") @db.Timestamptz()
  expiresAt          DateTime?   @map("expires_at") @db.Timestamptz()
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  buyer   User     @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  // -- back-references --
  items         OrderItem[]
  voucherUsages VoucherUsage[]

  @@index([buyerId, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

/// @note CHECK exclusive arc: 'plan' -> plan_id; 'listing' -> listing_id + seller_share_rate + seller_amount_vnd
/// @note Hoan tien chi ap dung khi unit_price_vnd > 0
/// @note unit_price_vnd, seller_share_rate, seller_amount_vnd la SNAPSHOT
model OrderItem {
  id              String          @id @default(uuid()) @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  itemType        OrderItemType   @map("item_type")
  planId          String?         @map("plan_id") @db.Uuid
  listingId       String?         @map("listing_id") @db.Uuid
  unitPriceVnd    BigInt          @map("unit_price_vnd")
  sellerShareRate Decimal?        @map("seller_share_rate") @db.Decimal(4, 3)
  sellerAmountVnd BigInt?         @map("seller_amount_vnd")
  status          OrderItemStatus @default(active)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plan    Plan?    @relation(fields: [planId], references: [id], onDelete: Restrict)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Restrict)

  // -- back-references --
  entitlements  Entitlement[]
  subscriptions Subscription[]
  refundRequest RefundRequest?

  @@index([orderId])
  @@index([listingId])
  @@map("order_items")
}

model VoucherUsage {
  voucherId String   @map("voucher_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  usedAt    DateTime @default(now()) @map("used_at") @db.Timestamptz()

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([voucherId, orderId])
  @@index([voucherId, userId])
  @@map("voucher_usages")
}

/// @note Chi trong 7 ngay ke tu orders.paid_at (validator tang service)
model RefundRequest {
  id                 String        @id @default(uuid()) @db.Uuid
  orderItemId        String        @unique @map("order_item_id") @db.Uuid
  requesterId        String        @map("requester_id") @db.Uuid
  reason             String
  status             RequestStatus @default(pending)
  handledBy          String?       @map("handled_by") @db.Uuid
  handledAt          DateTime?     @map("handled_at") @db.Timestamptz()
  bankTransactionRef String?       @map("bank_transaction_ref") @db.VarChar(100)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  requester User      @relation("RefundRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  handler   User?     @relation("RefundHandler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@map("refund_requests")
}

model WebhookLog {
  id             BigInt   @id @default(autoincrement())
  provider       String   @default("payos") @db.VarChar(30)
  payosOrderCode BigInt?  @map("payos_order_code")
  payload        Json     @db.JsonB
  signatureValid Boolean  @map("signature_valid")
  processed      Boolean  @default(false)
  errorMessage   String?  @map("error_message")
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz()

  @@index([payosOrderCode])
  @@map("webhook_logs")
}

/// @note CHECK: moi cot so du >= 0
/// @note Cap nhat bang SELECT ... FOR UPDATE
/// @note Bat bien: moi so du = tong wallet_ledger tuong ung
/// @note Credit chi den tu goi, het han cuoi thang, khong doi ra tien, khong chuyen tu doanh thu
model Wallet {
  userId              String   @id @map("user_id") @db.Uuid
  creditBalance       Int      @default(0) @map("credit_balance")
  earningPendingVnd   BigInt   @default(0) @map("earning_pending_vnd")
  earningAvailableVnd BigInt   @default(0) @map("earning_available_vnd")
  earningLockedVnd    BigInt   @default(0) @map("earning_locked_vnd")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("wallets")
}

/// @note APPEND-ONLY. Migration REVOKE UPDATE, DELETE tren bang nay
/// @note amount: co dau
/// @note available_at: earning_pending -> thoi diem duoc chuyen kha dung (+7 ngay)
/// @note ref_type: subscription | order_item | ai_request | withdrawal
model WalletLedger {
  id             BigInt          @id @default(autoincrement())
  userId         String          @map("user_id") @db.Uuid
  walletType     WalletType      @map("wallet_type")
  entryType      LedgerEntryType @map("entry_type")
  amount         BigInt
  balanceAfter   BigInt          @map("balance_after")
  availableAt    DateTime?       @map("available_at") @db.Timestamptz()
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(120)
  refType        String?         @map("ref_type") @db.VarChar(50)
  refId          String?         @map("ref_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, walletType, createdAt])
  @@index([refType, refId])
  @@index([entryType, availableAt])
  @@map("wallet_ledger")
}

/// @note CHECK: amount_vnd >= muc toi thieu (platform_settings.min_withdrawal)
/// @note Partial unique: UNIQUE (seller_id) WHERE status = 'requested'
model WithdrawalRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  sellerId           String           @map("seller_id") @db.Uuid
  amountVnd          BigInt           @map("amount_vnd")
  bankSnapshot       Json             @map("bank_snapshot") @db.JsonB
  status             WithdrawalStatus @default(requested)
  handledBy          String?          @map("handled_by") @db.Uuid
  handledAt          DateTime?        @map("handled_at") @db.Timestamptz()
  bankTransactionRef String?          @map("bank_transaction_ref") @db.VarChar(100)
  rejectReason       String?          @map("reject_reason")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  seller  SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Restrict)
  handler User?         @relation("WithdrawalHandler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([sellerId])
  @@map("withdrawal_requests")
}

/// @note key: commission_rate | holding_days | min_withdrawal | report_threshold |
///       ai_cost.<type> (credit) | limits.* | story_layout.<length> | custom_limits.*
model PlatformSetting {
  key       String   @id @db.VarChar(60)
  value     Json     @db.JsonB
  updatedBy String   @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  updater User @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("platform_settings")
}

// =============================================================================
// 8. MODERATION & MONITORING
// =============================================================================

/// @note Chi quyet dinh 'approved' khi da xem 100% trang va tick du checklist
model ModerationReview {
  id             String               @id @default(uuid()) @db.Uuid
  listingId      String               @map("listing_id") @db.Uuid
  reviewType     ModerationReviewType @map("review_type")
  moderatorId    String?              @map("moderator_id") @db.Uuid
  claimedAt      DateTime?            @map("claimed_at") @db.Timestamptz()
  claimExpiresAt DateTime?            @map("claim_expires_at") @db.Timestamptz()
  decision       ModerationDecision?
  comment        String?
  decidedAt      DateTime?            @map("decided_at") @db.Timestamptz()
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  moderator User?   @relation("ModReviewModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  // -- back-references --
  checklistResults ReviewChecklistResult[]
  pageViews        ReviewPageView[]

  @@index([decidedAt, createdAt])
  @@index([listingId])
  @@map("moderation_reviews")
}

model ReviewChecklistResult {
  reviewId        String  @map("review_id") @db.Uuid
  checklistItemId String  @map("checklist_item_id") @db.Uuid
  passed          Boolean

  review        ModerationReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem    @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)

  @@id([reviewId, checklistItemId])
  @@map("review_checklist_results")
}

/// @note comment: nhan xet gan vao trang (bao gom diem dung ngay sau trang)
model ReviewPageView {
  reviewId String   @map("review_id") @db.Uuid
  pageId   String   @map("page_id") @db.Uuid
  viewedAt DateTime @default(now()) @map("viewed_at") @db.Timestamptz()
  comment  String?

  review ModerationReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  page   StoryPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([reviewId, pageId])
  @@map("review_page_views")
}

/// @note CHECK: dung mot trong listing_id / product_review_id
/// @note Partial unique: UNIQUE (reporter_id, listing_id) WHERE listing_id IS NOT NULL
/// @note Tu tam go: >= N nguoi bao cao khac nhau trong 24 gio -> listing suspended
model ContentReport {
  id              String         @id @default(uuid()) @db.Uuid
  reporterId      String         @map("reporter_id") @db.Uuid
  listingId       String?        @map("listing_id") @db.Uuid
  pageId          String?        @map("page_id") @db.Uuid
  productReviewId String?        @map("product_review_id") @db.Uuid
  category        ReportCategory
  description     String?
  status          ReportStatus   @default(open)
  handledBy       String?        @map("handled_by") @db.Uuid
  handledAt       DateTime?      @map("handled_at") @db.Timestamptz()
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  reporter      User           @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  listing       Listing?       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  page          StoryPage?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  productReview ProductReview? @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  handler       User?          @relation("ReportHandler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([listingId, createdAt])
  @@map("content_reports")
}

/// @note expires_at: +90 ngay
/// @note 3 canh cao con hieu luc -> seller_profiles.status = 'suspended'
model CreatorStrike {
  id        String       @id @default(uuid()) @db.Uuid
  sellerId  String       @map("seller_id") @db.Uuid
  source    StrikeSource
  sourceId  String?      @map("source_id") @db.Uuid
  reason    String
  issuedBy  String       @map("issued_by") @db.Uuid
  issuedAt  DateTime     @default(now()) @map("issued_at") @db.Timestamptz()
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  revokedAt DateTime?    @map("revoked_at") @db.Timestamptz()

  seller SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Restrict)
  issuer User          @relation("StrikeIssuer", fields: [issuedBy], references: [id], onDelete: Restrict)

  // -- back-references --
  appeal StrikeAppeal?

  @@index([sellerId, expiresAt])
  @@map("creator_strikes")
}

/// @note decided_by: admin, khac nguoi ra canh cao
model StrikeAppeal {
  id           String        @id @default(uuid()) @db.Uuid
  strikeId     String        @unique @map("strike_id") @db.Uuid
  reason       String
  status       RequestStatus @default(pending)
  decidedBy    String?       @map("decided_by") @db.Uuid
  decidedAt    DateTime?     @map("decided_at") @db.Timestamptz()
  decisionNote String?       @map("decision_note")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  strike  CreatorStrike @relation(fields: [strikeId], references: [id], onDelete: Cascade)
  decider User?         @relation("AppealDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@map("strike_appeals")
}

model AdminAuditLog {
  id          BigInt   @id @default(autoincrement())
  actorId     String   @map("actor_id") @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String?  @map("target_type") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.Uuid
  beforeState Json?    @map("before_state") @db.JsonB
  afterState  Json?    @map("after_state") @db.JsonB
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
